    skos:definition "The outer third of the lung parenchyma, measured from the pleural surface toward the hilum." ;
    cde:changeRequest "RADLEX-REQ-0101" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "A zone, not a structure. RadLex names no peripheral zone of lung. Category named in 06-anatomic-location.md under 'Places that are not structures'." ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "AL-L0001" ;
    cde:nodeType "AnatomicLocation" ;
    cde:source "local" ;
    cde:sourceStatus "pending_request" ;
    cde:versionNumber 1 ;
    cde:versionStatus "draft" .

