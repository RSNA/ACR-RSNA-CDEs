anat:RID29840 a owl:Class ;
    rdfs:label "trunk proper" ;
    rdfs:subClassOf cde:AnatomicLocation,
        anat:RID13404 ;
    skos:altLabel "trunk front" ;
    skos:definition "Subdivision of trunk which is demarcated from the back of trunk by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall and from the limbs by the inguinal folds; together with the back of trunk, it constitutes the trunk. Examples: There is only one trunk proper." ;
    skos:exactMatch radlex:RID29840 ;
    skos:prefLabel "trunk proper" ;
    cde:created "2026-09-10"^^xsd:date ;
