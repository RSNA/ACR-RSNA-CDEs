    cde:versionStatus "published" .

cde:constitutionalPartOf a owl:ObjectProperty ;
    rdfs:comment "RadLex Constitutional_Part_Of." ;
    rdfs:subPropertyOf cde:partOf .

cde:containedIn a owl:ObjectProperty ;
    rdfs:comment "Location, not mereology: a kidney is in the abdomen, it is not part of it. Deliberately NOT a subproperty of partOf and deliberately not in the scopedToRegion chain, so a scope claim never travels along it. Traversed only to derive the body-region facet." .

cde:regionalPartOf a owl:ObjectProperty ;
    rdfs:comment "RadLex Regional_Part_Of." ;
    rdfs:subPropertyOf cde:partOf .

cde:generalPartOf a owl:ObjectProperty ;
    rdfs:comment "RadLex Part_Of." ;
    rdfs:subPropertyOf cde:partOf .

cde:AnatomicLocation a owl:Class .

