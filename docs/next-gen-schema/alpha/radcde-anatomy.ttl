anat:RID7578 a owl:Class ;
    rdfs:label "thyroid gland" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:containedIn ;
            owl:someValuesFrom anat:RID7577 ],
        [ a owl:Restriction ;
            owl:onProperty cde:generalPartOf ;
            owl:someValuesFrom anat:RID7576 ],
        cde:AnatomicLocation,
        anat:RID13419 ;
    skos:altLabel "thyroid",
        "glandula thyroidea"@la ;
    skos:definition "A highly vascularized endocrine gland consisting of two lobes joined by a thin band of tissue with one lobe on each side of the trachea. It secretes thyroid hormones from the follicular cells and calcitonin from the parafollicular cells thereby regulating metabolism and calcium level in blood, respectively. [MeSH]" ;
    skos:exactMatch radlex:RID7578,
        sct:69748006 ;
    skos:prefLabel "thyroid gland" ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-RID7578-RADLEX-RID7578,
        cde:binding-RID7578-SNOMEDCT-69748006 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "thyroid" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "AL-000078" ;
    cde:nodeType "AnatomicLocation" ;
    cde:source "imported" ;
    cde:sourceDefinition "A highly vascularized endocrine gland consisting of two lobes joined by a thin band of tissue with one lobe on each side of the trachea. It secretes thyroid hormones from the follicular cells and calcitonin from the parafollicular cells thereby regulating metabolism and calcium level in blood, respectively. [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

anat:RID88 a owl:Class ;
    rdfs:label "adrenal gland" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:containedIn ;
            owl:someValuesFrom anat:RID431 ],
        cde:AnatomicLocation,
        anat:RID28902 ;
    skos:altLabel "glandula suprarenalis"@la ;
    skos:definition "A pair of glands located at the cranial pole of each of the two kidneys. Each adrenal gland is composed of two distinct endocrine tissues with separate embryonic origins, the adrenal cortex producing steroids and the adrenal medulla producing neurotransmitters. [MeSH]" ;
    skos:exactMatch radlex:RID88,
        sct:23451007 ;
