                   owl:disjointWith cde:ScopeStated ,
                                    cde:ScopeUnresolved ;
                   rdfs:label "not stated" ;
                   skos:definition "The source names no anatomic location. A fact about the report. Produces an UnresolvedMention, not a finding." ;
                   cde:created "2026-09-10"^^xsd:date ;
                   cde:lastModified "2026-09-10"^^xsd:date ;
                   cde:localId "SR-000002" ;
                   cde:nodeType "ScopeResolution" ;
                   cde:versionNumber 1 ;
                   cde:versionStatus "proposed" .


###  https://radelement.org/ng/ScopeResolution
cde:ScopeResolution rdf:type owl:Class ;
                    rdfs:comment "Why an observation carries no anatomic scope. Same four-way shape as the presence element: the absence is recorded with its reason rather than left to a reader. Without it, one class means genuinely generic, the report did not say, and the extractor failed." .


###  https://radelement.org/ng/ScopeStated
cde:ScopeStated rdf:type owl:Class ;
                rdfs:subClassOf cde:ScopeResolution ;
                owl:disjointWith cde:ScopeUnresolved ;
                rdfs:label "stated" ;
                skos:definition "The source names an anatomic location and it was resolved to a node." ;
                cde:created "2026-09-10"^^xsd:date ;
                cde:lastModified "2026-09-10"^^xsd:date ;
                cde:localId "SR-000001" ;
                cde:nodeType "ScopeResolution" ;
                cde:versionNumber 1 ;
                cde:versionStatus "proposed" .


###  https://radelement.org/ng/ScopeUnresolved
cde:ScopeUnresolved rdf:type owl:Class ;
                    rdfs:subClassOf cde:ScopeResolution ;
                    rdfs:label "unresolved" ;
                    skos:definition "The source names a location that extraction did not resolve. A fact about the pipeline and a defect rather than a finding. Produces an UnresolvedMention." ;
                    cde:created "2026-09-10"^^xsd:date ;
                    cde:lastModified "2026-09-10"^^xsd:date ;
                    cde:localId "SR-000004" ;
                    cde:nodeType "ScopeResolution" ;
                    cde:versionNumber 1 ;
                    cde:versionStatus "proposed" .


###  https://radelement.org/ng/SeverityValue
cde:SeverityValue rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( cde:V_000190_Minimal
                                                      cde:V_000191_Mild
                                                      cde:V_000192_Moderate
                                                      cde:V_000193_Severe
                                                    )
                                      ] ;
                  rdfs:subClassOf cde:Value ;
                  rdfs:comment "Permitted answers for the 'severity' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
                  rdfs:label "severity value" .


