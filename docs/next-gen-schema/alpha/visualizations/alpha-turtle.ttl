                                  cde:lastModified "2026-09-10"^^xsd:date ;
                                  cde:localId "V-000361" ;
                                  cde:nodeType "Value" ;
                                  cde:sourceDefinition "The largest and most complex of the cerebral arteries. Branches of the middle cerebral artery supply the insular region, motor and premotor areas, and large regions of the association cortex. [MeSH]" ;
                                  cde:versionNumber 1 ;
                                  cde:versionStatus "proposed" .


