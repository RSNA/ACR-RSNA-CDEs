 ] .


###  https://radelement.org/ng/Pneumonia
cde:Pneumonia rdf:type owl:Class ;
              rdfs:subClassOf cde:Diagnosis ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cde:hasEtiology ;
                                owl:someValuesFrom cde:Infectious
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cde:hasPresence ;
                                owl:someValuesFrom cde:PresenceValue
                              ] ,
                              _:genid607 ,
                              _:genid609 ,
                              _:genid611 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cde:scopedToSpecific ;
                                owl:someValuesFrom <https://radelement.org/ng/anatomy/RID35739>
                              ] ;
              rdfs:label "pneumonia" ;
              skos:definition "Infection of the lung parenchyma." ;
              skos:exactMatch <http://radlex.org/RID/RID5350> ,
                              <http://snomed.info/id/233604007> ;
              skos:prefLabel "pneumonia" ;
              cde:anchorVerdict "anchored" ;
              cde:conceptSource "Fleischner Society" ;
              cde:created "2026-09-10"^^xsd:date ;
              cde:hasBinding cde:binding-Pneumonia-RADLEX-RID5350 ,
                             cde:binding-Pneumonia-SNOMEDCT-233604007 ;
              cde:lastModified "2026-09-10"^^xsd:date ;
              cde:localId "DX-000016" ;
              cde:nodeType "Diagnosis" ;
              cde:sourceDefinition """Inflammation of the lungs. [MeSH]
Pathology.—Pneumonia is inflammation of the airspaces and/or interstitium (eg, due to infection, as in bacterial pneumonia). Infective pneumonia is characterized by exudate resulting in consolidation. The term is also used to refer to a number of noninfectious disorders of the lung parenchyma characterized by varying degrees of inflammation and fibrosis (eg, idiopathic interstitial pneumonias) (5).  [Fleischner Society]""" ;
              cde:versionNumber 1 ;
              cde:versionStatus "proposed" .

_:genid607 rdf:type owl:Restriction ;
            owl:onProperty cde:mayCause ;
            owl:someValuesFrom cde:PleuralEffusion .

_:genid609 rdf:type owl:Restriction ;
            owl:onProperty cde:mayManifestAs ;
            owl:someValuesFrom cde:Consolidation .

_:genid611 rdf:type owl:Restriction ;
            owl:onProperty cde:mayManifestAs ;
            owl:someValuesFrom cde:GroundGlassOpacity .

