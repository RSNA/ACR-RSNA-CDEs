              skos:prefLabel "renal mass" ;
              cde:anchorVerdict "anchored" ;
              cde:conceptSource "‘CT Kidney and Abdominal Renal Mass’ report template" ;
              cde:created "2026-09-10"^^xsd:date ;
              cde:designNote "Kept distinct from renal lesion. Radiologists say both with a real difference: a mass asserts space-occupying behaviour, a lesion does not." ;
              cde:hasBinding cde:binding-RenalMass-RADLEX-RID50658 ,
