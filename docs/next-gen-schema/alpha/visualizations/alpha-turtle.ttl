                                            cde:hasBinding cde:binding-RID1362-RADLEX-RID1362 ,
                                                           cde:binding-RID1362-SNOMEDCT-3120008 ;
                                            cde:lastModified "2026-09-10"^^xsd:date ;
                                            cde:localId "AL-000046" ;
                                            cde:nodeType "AnatomicLocation" ;
                                            cde:source "imported" ;
                                            cde:sourceDefinition "The thin serous membrane enveloping the lungs (lung) and lining the thoracic cavity. Pleura consist of two layers, the inner visceral pleura lying next to the pulmonary parenchyma and the outer parietal pleura. Between the two layers is the pleural cavity which contains a thin film of liquid. [MeSH]" ;
                                            cde:versionNumber 1 ;
                                            cde:versionStatus "published" .


