                    rdfs:comment "Relates an observation to the reason its anatomic scope is or is not resolved." .


###  https://radelement.org/ng/scopedTo
cde:scopedTo rdf:type owl:ObjectProperty ;
             rdfs:comment "Relates a definition to an AnatomicLocation." .


###  https://radelement.org/ng/scopedToClass
cde:scopedToClass rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf cde:scopedTo ;
                  rdfs:comment "Scope checked taxonomically. kind=class." .


###  https://radelement.org/ng/scopedToRegion
cde:scopedToRegion rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf cde:scopedTo ;
                   owl:propertyChainAxiom ( cde:scopedToRegion
                                            cde:partOf
                                          ) ;
                   rdfs:comment "Scope checked by containment along partOf. kind=region." ;
                   cde:designNote "Property chain scopedToRegion o partOf -> scopedToRegion. A finding scoped to a lobe is thereby scoped to the lung, without every combination being written out. This is the mechanism behind decision-register item 3, anatomic scope stored or inferred." .


###  https://radelement.org/ng/scopedToSpecific
cde:scopedToSpecific rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf cde:scopedTo ;
                     rdfs:comment "Scope checked by identity or subsumption. kind=specific." .


