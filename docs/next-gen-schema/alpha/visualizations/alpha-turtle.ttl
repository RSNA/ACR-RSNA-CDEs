@prefix : <https://radelement.org/ng/radcde-standalone#> .
@prefix cde: <https://radelement.org/ng/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://radelement.org/ng/radcde-standalone> .

<https://radelement.org/ng/radcde-standalone> rdf:type owl:Ontology ;
                                               dcterms:title "RadElement next-gen alpha (single file, no imports)" ;
                                               rdfs:comment "Authored definition layer and imported anatomy merged into one file. No owl:imports and no catalog needed. Equivalent in content to radcde-alpha.ttl plus radcde-anatomy.ttl." ;
                                               owl:versionInfo "alpha-0.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
skos:narrowMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  https://radelement.org/ng/anchorBase
cde:anchorBase rdf:type owl:AnnotationProperty ;
               rdfs:comment "The head concept of a post-coordinated anchor: what the finding IS. Pulmonary mass has base mass. Points at the source concept, the same way a binding does, rather than naming it in text." .


###  https://radelement.org/ng/anchorModifier
cde:anchorModifier rdf:type owl:AnnotationProperty ;
                   rdfs:comment "A concept that restricts the base. Pulmonary mass has modifier lung. Base plus modifiers says how the anchor composes, which a flat list of codes does not." .


###  https://radelement.org/ng/anchorVerdict
cde:anchorVerdict rdf:type owl:AnnotationProperty ;
                  rdfs:comment "anchored, post_coordinated, unanchored_requestable or out_of_primary_scope. How the concept relates to the primary anchor." .


###  https://radelement.org/ng/bindingCode
cde:bindingCode rdf:type owl:AnnotationProperty ;
                rdfs:comment "Code in that terminology." .


###  https://radelement.org/ng/bindingMatch
cde:bindingMatch rdf:type owl:AnnotationProperty ;
                 rdfs:comment "SKOS mapping strength of the binding." .


###  https://radelement.org/ng/bindingSystem
cde:bindingSystem rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Terminology identifier of a binding." .


###  https://radelement.org/ng/changeRequest
cde:changeRequest rdf:type owl:AnnotationProperty ;
                  rdfs:comment "External change-request reference for a local object." .


###  https://radelement.org/ng/conceptSource
cde:conceptSource rdf:type owl:AnnotationProperty ;
                  rdfs:comment "The body the source terminology credits for the concept (Fleischner, PI-RADS, LI-RADS...)." .


###  https://radelement.org/ng/created
cde:created rdf:type owl:AnnotationProperty ;
            rdfs:comment "Creation date." .


###  https://radelement.org/ng/criterion
cde:criterion rdf:type owl:AnnotationProperty ;
              rdfs:comment "A stated criterion carried as an annotation rather than as a defining condition." .


###  https://radelement.org/ng/designNote
cde:designNote rdf:type owl:AnnotationProperty ;
               rdfs:comment "A note recorded during alpha construction." .


###  https://radelement.org/ng/epistemic
cde:epistemic rdf:type owl:AnnotationProperty ;
              rdfs:comment "True where a relation holds between our knowledge of two things rather than between the things." .


###  https://radelement.org/ng/exclusiveValue
cde:exclusiveValue rdf:type owl:AnnotationProperty ;
                   rdfs:comment "A value whose selection excludes every sibling. Used for a none option on a multi-select element, where value disjointness alone does not prevent none being asserted alongside a pattern." .


###  https://radelement.org/ng/hasBinding
cde:hasBinding rdf:type owl:AnnotationProperty .


###  https://radelement.org/ng/hasSynonym
cde:hasSynonym rdf:type owl:AnnotationProperty .


###  https://radelement.org/ng/inferenceBearing
cde:inferenceBearing rdf:type owl:AnnotationProperty ;
                     rdfs:comment "False where software must not draw conclusions from this relation." .


###  https://radelement.org/ng/isComponent
cde:isComponent rdf:type owl:AnnotationProperty ;
                rdfs:comment "True where the class is reached only through HAS_COMPONENT." .


###  https://radelement.org/ng/issuingAuthority
cde:issuingAuthority rdf:type owl:AnnotationProperty ;
                     rdfs:comment "The body that issues an assessment scheme." .


###  https://radelement.org/ng/lastModified
cde:lastModified rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Last modification date." .


###  https://radelement.org/ng/localId
cde:localId rdf:type owl:AnnotationProperty ;
            rdfs:comment "The type-prefixed identifier of the corresponding node in the definition graph." .


###  https://radelement.org/ng/measurementMethod
cde:measurementMethod rdf:type owl:AnnotationProperty ;
                      rdfs:comment "The convention by which a measurement is taken." .


###  https://radelement.org/ng/mentionTerm
cde:mentionTerm rdf:type owl:AnnotationProperty ;
                rdfs:comment "The term in the source text that a mention names." .


###  https://radelement.org/ng/misspelling
cde:misspelling rdf:type owl:AnnotationProperty ;
                rdfs:comment "A misspelling the source records for this concept. Like unsanctionedTerm, a subproperty of the source's Synonym and therefore NOT a synonym." .


###  https://radelement.org/ng/modalityRestriction
cde:modalityRestriction rdf:type owl:AnnotationProperty ;
                        rdfs:comment "Restricts an element or measurement to a subset of the modalities the finding is seen on." .


###  https://radelement.org/ng/narrowsTo
cde:narrowsTo rdf:type owl:AnnotationProperty ;
              rdfs:comment "The subset of an element's values permitted at this point of use. Advisory in alpha: enforced by lint, not by an axiom." .


###  https://radelement.org/ng/noImagingElements
cde:noImagingElements rdf:type owl:AnnotationProperty ;
                      rdfs:comment "True on a diagnosis carried only so causal edges have a target." .


###  https://radelement.org/ng/nodeType
cde:nodeType rdf:type owl:AnnotationProperty ;
             rdfs:comment "Which node type of the definition graph this entity serialises." .


###  https://radelement.org/ng/permittedUnit
cde:permittedUnit rdf:type owl:AnnotationProperty ;
                  rdfs:comment "A UCUM unit code permitted for a measurement." .


###  https://radelement.org/ng/primaryBinding
cde:primaryBinding rdf:type owl:AnnotationProperty ;
                   rdfs:comment "True on the one binding whose hierarchy is imported." .


###  https://radelement.org/ng/quantityKind
cde:quantityKind rdf:type owl:AnnotationProperty ;
                 rdfs:comment "The kind of quantity a measurement reports." .


###  https://radelement.org/ng/rank
cde:rank rdf:type owl:AnnotationProperty ;
         rdfs:comment "Position in an ordered value list. Present on every value of an element or on none." .


###  https://radelement.org/ng/refinementKind
cde:refinementKind rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Which kind of anatomy a scope may be narrowed to on a particular observation. The permitted concepts are derived from it, never authored, and are enumerated in the compiled shape. Stated here as text rather than as an axiom because the axiom would not bite: no anatomy class in this build is declared disjoint from any other, so an allValuesFrom restriction on the kind rules nothing out." .


###  https://radelement.org/ng/replacedBy
cde:replacedBy rdf:type owl:AnnotationProperty ;
               rdfs:comment "Retirement pointer from the source terminology." .


###  https://radelement.org/ng/schemeScope
cde:schemeScope rdf:type owl:AnnotationProperty ;
                rdfs:comment "observation, exam or side." .


###  https://radelement.org/ng/schemeVersion
cde:schemeVersion rdf:type owl:AnnotationProperty ;
                  rdfs:comment "The scheme's own version clock, independent of ours." .


###  https://radelement.org/ng/scopeStrength
cde:scopeStrength rdf:type owl:AnnotationProperty ;
                  rdfs:comment "required, expected or unconstrained. Declares how binding a scope claim is." .


###  https://radelement.org/ng/selectCardinality
cde:selectCardinality rdf:type owl:AnnotationProperty ;
                      rdfs:comment "single or multi. Single-select elements are declared owl:FunctionalProperty; multi-select ones are not. Value disjointness alone does not give single-select." .


###  https://radelement.org/ng/source
cde:source rdf:type owl:AnnotationProperty ;
           rdfs:comment "imported or local." .


###  https://radelement.org/ng/sourceChangeLog
cde:sourceChangeLog rdf:type owl:AnnotationProperty ;
                    rdfs:comment "The source terminology's own per-concept change history." .


###  https://radelement.org/ng/sourceDefinition
cde:sourceDefinition rdf:type owl:AnnotationProperty ;
                     rdfs:comment "The source terminology's definition, kept distinct from ours." .


###  https://radelement.org/ng/sourceLabel
cde:sourceLabel rdf:type owl:AnnotationProperty ;
                rdfs:comment "That terminology's label for the code, as of sourceVersion." .


###  https://radelement.org/ng/sourceRef
cde:sourceRef rdf:type owl:AnnotationProperty ;
              rdfs:comment "Where in the modelling corpus the example came from." .


###  https://radelement.org/ng/sourceStatus
cde:sourceStatus rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Relationship of a local object to the source terminology." .


###  https://radelement.org/ng/sourceText
cde:sourceText rdf:type owl:AnnotationProperty ;
               rdfs:comment "Report text an instance example was drawn from." .


###  https://radelement.org/ng/sourceVersion
cde:sourceVersion rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Terminology release the binding was resolved against." .


###  https://radelement.org/ng/specificity
cde:specificity rdf:type owl:AnnotationProperty ;
                rdfs:comment "How much seeing the target narrows the differential: suggestive, highly_suggestive, pathognomonic. Read backward, finding to diagnosis." .


###  https://radelement.org/ng/synonymOnlyHit
cde:synonymOnlyHit rdf:type owl:AnnotationProperty ;
                   rdfs:comment "True where the anchor concept is reachable only through the source's synonym field." .


###  https://radelement.org/ng/synonymScope
cde:synonymScope rdf:type owl:AnnotationProperty ;
                 rdfs:comment "exact, narrow, broad or related. Stops a narrow synonym being treated as an exact hit." .


###  https://radelement.org/ng/synonymTerm
cde:synonymTerm rdf:type owl:AnnotationProperty ;
                rdfs:comment "An alternate term for the concept." .


###  https://radelement.org/ng/synonymType
cde:synonymType rdf:type owl:AnnotationProperty ;
                rdfs:comment "synonym, abbreviation, acronym or eponym." .


###  https://radelement.org/ng/typicality
cde:typicality rdf:type owl:AnnotationProperty ;
               rdfs:comment "How often the source shows the target: occasional, frequent, very_frequent, obligate. Read forward, diagnosis to finding." .


###  https://radelement.org/ng/unsanctionedTerm
cde:unsanctionedTerm rdf:type owl:AnnotationProperty ;
                     rdfs:comment "A term the source terminology explicitly discourages for this concept. NOT a synonym: never emitted as skos:altLabel and never matched by duplicate detection." .


###  https://radelement.org/ng/versionNumber
cde:versionNumber rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Version of this object." .


###  https://radelement.org/ng/versionStatus
cde:versionStatus rdf:type owl:AnnotationProperty ;
                  rdfs:comment "draft, proposed, published, retired or superseded." .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://radelement.org/ng/abuts
cde:abuts rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf cde:actsOn ;
          rdfs:comment "Contacts a structure without disrupting it." .


###  https://radelement.org/ng/actsOn
cde:actsOn rdf:type owl:ObjectProperty ;
           rdfs:comment "A mass-effect relation between a finding and an adjacent structure." .


###  https://radelement.org/ng/assessedBy
cde:assessedBy rdf:type owl:ObjectProperty ;
               rdfs:comment "Relates a FindingClass or Diagnosis to an AssessmentScheme." .


###  https://radelement.org/ng/assessedByCategory
cde:assessedByCategory rdf:type owl:ObjectProperty .


###  https://radelement.org/ng/causesFinding
cde:causesFinding rdf:type owl:ObjectProperty ;
                  rdfs:comment "A finding downstream of another finding." .


###  https://radelement.org/ng/componentOf
cde:componentOf rdf:type owl:ObjectProperty ;
                owl:inverseOf cde:hasComponent ;
                rdf:type owl:FunctionalProperty ;
                rdfs:comment "Inverse of hasComponent. Functional: a sub-finding with no standalone meaning belongs to exactly one whole. This is what lets a conditional relationship be carried on the component rather than asserted as a requirement on the whole." .


###  https://radelement.org/ng/constitutionalPartOf
cde:constitutionalPartOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf cde:partOf ;
                         rdfs:comment "RadLex Constitutional_Part_Of." .


###  https://radelement.org/ng/containedIn
cde:containedIn rdf:type owl:ObjectProperty ;
                rdfs:comment "Location, not mereology: a kidney is in the abdomen, it is not part of it. Deliberately NOT a subproperty of partOf and deliberately not in the scopedToRegion chain, so a scope claim never travels along it. Traversed only to derive the body-region facet." .


###  https://radelement.org/ng/derivedFromMeasurement
cde:derivedFromMeasurement rdf:type owl:ObjectProperty ;
                           rdfs:comment "Relates a Measurement to the measurements it is computed from." .


###  https://radelement.org/ng/displaces
cde:displaces rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf cde:actsOn ;
              rdfs:comment "Moves a structure from its expected position." .


###  https://radelement.org/ng/encases
cde:encases rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf cde:actsOn ;
            rdfs:comment "Surrounds a structure circumferentially." .


###  https://radelement.org/ng/erodes
cde:erodes rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf cde:actsOn ;
           rdfs:comment "Destroys the substance of a structure." .


###  https://radelement.org/ng/generalPartOf
cde:generalPartOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf cde:partOf ;
                  rdfs:comment "RadLex Part_Of." .


###  https://radelement.org/ng/hasAcuity
cde:hasAcuity rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf cde:hasDataElement ;
              rdf:type owl:FunctionalProperty ;
              rdfs:range cde:AcuityValue ;
              rdfs:label "acuity" ;
              skos:definition "How old the finding is, judged from its appearance rather than from a comparison. A healed fracture on a first study has no prior to compare against and is still recognisably old." ;
              cde:created "2026-09-10"^^xsd:date ;
              cde:lastModified "2026-09-10"^^xsd:date ;
              cde:localId "DE-000034" ;
              cde:nodeType "DataElement" ;
              cde:selectCardinality "single" ;
              cde:versionNumber 1 ;
              cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasAmount
cde:hasAmount rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf cde:hasDataElement ;
              rdf:type owl:FunctionalProperty ;
              rdfs:range cde:AmountValue ;
              rdfs:label "amount" ;
              skos:definition "How much material is present, on a coarse ordinal scale." ;
              cde:created "2026-09-10"^^xsd:date ;
              cde:lastModified "2026-09-10"^^xsd:date ;
              cde:localId "DE-000016" ;
              cde:nodeType "DataElement" ;
              cde:selectCardinality "single" ;
              cde:versionNumber 1 ;
              cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasAtelectasisMechanism
cde:hasAtelectasisMechanism rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf cde:hasDataElement ;
                            rdf:type owl:FunctionalProperty ;
                            rdfs:domain [ rdf:type owl:Restriction ;
                                          owl:onProperty cde:scopedToRegion ;
                                          owl:someValuesFrom <https://radelement.org/ng/anatomy/RID1301>
                                        ] ;
                            rdfs:range cde:AtelectasisMechanismValue ;
                            rdfs:label "atelectasis mechanism" ;
                            skos:definition "Why the lung has lost volume. The axis that changes management: obstructive implies an obstructing lesion and should prompt a search for one." ;
                            cde:created "2026-09-10"^^xsd:date ;
                            cde:lastModified "2026-09-10"^^xsd:date ;
                            cde:localId "DE-000042" ;
                            cde:nodeType "DataElement" ;
                            cde:selectCardinality "single" ;
                            cde:versionNumber 1 ;
                            cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasAtelectasisMorphology
cde:hasAtelectasisMorphology rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf cde:hasDataElement ;
                             rdf:type owl:FunctionalProperty ;
                             rdfs:domain [ rdf:type owl:Restriction ;
                                           owl:onProperty cde:scopedToRegion ;
                                           owl:someValuesFrom <https://radelement.org/ng/anatomy/RID1301>
                                         ] ;
                             rdfs:range cde:AtelectasisMorphologyValue ;
                             rdfs:label "atelectasis morphology" ;
                             skos:definition "What the volume loss looks like." ;
                             cde:created "2026-09-10"^^xsd:date ;
                             cde:lastModified "2026-09-10"^^xsd:date ;
                             cde:localId "DE-000043" ;
                             cde:nodeType "DataElement" ;
                             cde:selectCardinality "single" ;
                             cde:versionNumber 1 ;
                             cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasAttenuation
cde:hasAttenuation rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf cde:hasDataElement ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Restriction ;
                                 owl:onProperty cde:scopedToRegion ;
                                 owl:someValuesFrom <https://radelement.org/ng/anatomy/RID1301>
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cde:seenOn ;
                                 owl:someValuesFrom cde:CT
                               ] ;
                   rdfs:range cde:AttenuationValue ;
                   rdfs:label "attenuation" ;
                   skos:altLabel "density" ;
                   skos:definition "The density characteristics of a pulmonary nodule on CT." ;
                   cde:created "2026-09-10"^^xsd:date ;
                   cde:hasSynonym [ cde:synonymScope "exact" ;
                                    cde:synonymTerm "density" ;
                                    cde:synonymType "synonym"
                                  ] ;
                   cde:lastModified "2026-09-10"^^xsd:date ;
                   cde:localId "DE-000002" ;
                   cde:modalityRestriction "PulmonaryNodule on attenuation: CT" ;
                   cde:nodeType "DataElement" ;
                   cde:selectCardinality "single" ;
                   cde:versionNumber 1 ;
                   cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasCalcification
cde:hasCalcification rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf cde:hasDataElement ;
                     rdfs:range cde:CalcificationValue ;
                     rdfs:label "calcification" ;
                     skos:definition "The presence and pattern of calcium within the lesion." ;
                     cde:created "2026-09-10"^^xsd:date ;
                     cde:designNote "Multi-select. A lesion may carry more than one calcification pattern at once. This is the shape of the TI-RADS echogenic foci case" ;
                     cde:lastModified "2026-09-10"^^xsd:date ;
                     cde:localId "DE-000004" ;
                     cde:nodeType "DataElement" ;
                     cde:selectCardinality "multi" ;
                     cde:versionNumber 1 ;
                     cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasCategory
cde:hasCategory rdf:type owl:ObjectProperty ;
                rdfs:comment "Relates an AssessmentScheme to one of its categories." .


###  https://radelement.org/ng/hasCollectionShape
cde:hasCollectionShape rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf cde:hasDataElement ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:range cde:CollectionShapeValue ;
                       rdfs:label "collection shape" ;
                       skos:definition "The outline a collection takes, which reflects the space containing it." ;
                       cde:created "2026-09-10"^^xsd:date ;
                       cde:lastModified "2026-09-10"^^xsd:date ;
                       cde:localId "DE-000038" ;
                       cde:nodeType "DataElement" ;
                       cde:selectCardinality "single" ;
                       cde:versionNumber 1 ;
                       cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasComminution
cde:hasComminution rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf cde:hasDataElement ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:range cde:ComminutionValue ;
                   rdfs:label "comminution" ;
                   skos:definition "Whether a fracture has more than two fragments." ;
                   cde:created "2026-09-10"^^xsd:date ;
                   cde:lastModified "2026-09-10"^^xsd:date ;
                   cde:localId "DE-000028" ;
                   cde:nodeType "DataElement" ;
                   cde:selectCardinality "single" ;
                   cde:versionNumber 1 ;
                   cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasComponent
cde:hasComponent rdf:type owl:ObjectProperty ;
                 rdfs:comment "Relates a FindingClass to a sub-finding with no standalone meaning." .


###  https://radelement.org/ng/hasComposition
cde:hasComposition rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf cde:hasDataElement ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:range cde:CompositionValue ;
                   rdfs:label "composition" ;
                   skos:closeMatch <http://radlex.org/RID/RID39409> ;
                   skos:definition "The internal make-up of the lesion in terms of solid and fluid content." ;
                   cde:created "2026-09-10"^^xsd:date ;
                   cde:hasBinding cde:binding-hasComposition-RADLEX-RID39409 ;
                   cde:lastModified "2026-09-10"^^xsd:date ;
                   cde:localId "DE-000006" ;
                   cde:nodeType "DataElement" ;
                   cde:selectCardinality "single" ;
                   cde:versionNumber 1 ;
                   cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasDataElement
cde:hasDataElement rdf:type owl:ObjectProperty ;
                   rdfs:comment "Parent of every element property. Each DataElement is a subproperty." .


###  https://radelement.org/ng/hasDeviceIntegrity
cde:hasDeviceIntegrity rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf cde:hasDataElement ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:range cde:DeviceIntegrityValue ;
                       rdfs:label "device integrity" ;
                       skos:definition "Whether a device is intact and functioning as placed." ;
                       cde:created "2026-09-10"^^xsd:date ;
                       cde:lastModified "2026-09-10"^^xsd:date ;
                       cde:localId "DE-000025" ;
                       cde:nodeType "DataElement" ;
                       cde:selectCardinality "single" ;
                       cde:versionNumber 1 ;
                       cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasDirection
cde:hasDirection rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf cde:hasDataElement ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:range cde:DirectionValue ;
                 rdfs:label "direction" ;
                 skos:definition "Which way a structure is displaced from its expected position." ;
                 cde:created "2026-09-10"^^xsd:date ;
                 cde:lastModified "2026-09-10"^^xsd:date ;
                 cde:localId "DE-000021" ;
                 cde:nodeType "DataElement" ;
                 cde:selectCardinality "single" ;
                 cde:versionNumber 1 ;
                 cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasDistribution
cde:hasDistribution rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf cde:hasDataElement ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:range cde:DistributionValue ;
                    rdfs:label "distribution" ;
                    skos:definition "The spatial pattern of a multifocal finding across the organ or region." ;
                    cde:created "2026-09-10"^^xsd:date ;
                    cde:lastModified "2026-09-10"^^xsd:date ;
                    cde:localId "DE-000013" ;
                    cde:nodeType "DataElement" ;
                    cde:selectCardinality "single" ;
                    cde:versionNumber 1 ;
                    cde:versionStatus "proposed" .


###  https://radelement.org/ng/hasEcaStenosisSignificance
cde:hasEcaStenosisSignificance rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf cde:hasDataElement ;
                               rdf:type owl:FunctionalProperty ;
                               rdfs:domain [ rdf:type owl:Restriction ;
                                             owl:onProperty cde:scopedToRegion ;
                                             owl:someValuesFrom <https://radelement.org/ng/anatomy/RID684>
                                           ] ;
