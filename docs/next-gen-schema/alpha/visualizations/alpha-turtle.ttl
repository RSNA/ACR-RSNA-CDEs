                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:unionOf ( cde:V_000400_CysticOrAlmostCompletelyCystic
                                                                cde:V_000401_Spongiform
                                                                cde:V_000402_MixedCysticAndSolid
                                                                cde:V_000403_SolidOrAlmostCompletelySolid
                                                              )
                                                ] ;
                            rdfs:subClassOf cde:Value ;
                            rdfs:comment "Permitted answers for the 'thyroid composition' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
                            rdfs:label "thyroid composition value" .


###  https://radelement.org/ng/ThyroidMarginValue
cde:ThyroidMarginValue rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:unionOf ( cde:V_000390_Smooth
                                                           cde:V_000391_IllDefined
                                                           cde:V_000392_Lobulated
                                                           cde:V_000393_Irregular
                                                           cde:V_000394_ExtraThyroidalExtension
                                                         )
                                           ] ;
                       rdfs:subClassOf cde:Value ;
                       rdfs:comment "Permitted answers for the 'thyroid margin' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
                       rdfs:label "thyroid margin value" .


###  https://radelement.org/ng/ThyroidNodule
cde:ThyroidNodule rdf:type owl:Class ;
                  rdfs:subClassOf cde:FindingClass ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:assessedBy ;
                                    owl:someValuesFrom cde:TIRADS
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasEchogenicFoci ;
                                    owl:someValuesFrom cde:EchogenicFociValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasEchogenicity ;
                                    owl:someValuesFrom cde:EchogenicityValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasIntervalChange ;
                                    owl:someValuesFrom cde:IntervalChangeValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasLaterality ;
                                    owl:someValuesFrom cde:LateralityValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasMeasurement ;
                                    owl:someValuesFrom cde:LesionCount
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasMeasurement ;
                                    owl:someValuesFrom cde:LongAxisDiameter
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasMeasurement ;
                                    owl:someValuesFrom cde:MeanDiameter
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasPresence ;
                                    owl:someValuesFrom cde:PresenceValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasThyroidComposition ;
                                    owl:someValuesFrom cde:ThyroidCompositionValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:hasThyroidMargin ;
                                    owl:someValuesFrom cde:ThyroidMarginValue
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:inSubspecialty ;
                                    owl:someValuesFrom cde:SP_HN
                                  ] ,
                                  _:genid914 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:seenOn ;
                                    owl:someValuesFrom cde:CT
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:seenOn ;
                                    owl:someValuesFrom cde:MR
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:seenOn ;
                                    owl:someValuesFrom cde:US
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cde:seenOn ;
                                    owl:someValuesFrom cde:XR
                                  ] ;
                  rdfs:label "thyroid nodule" ;
                  skos:definition "A nodule within the thyroid gland." ;
                  skos:exactMatch <http://radlex.org/RID/RID50509> ,
                                  <http://snomed.info/id/237495005> ;
                  skos:prefLabel "thyroid nodule" ;
                  cde:anchorVerdict "anchored" ;
                  cde:conceptSource "ACR TI-RADS" ;
                  cde:created "2026-09-10"^^xsd:date ;
                  cde:designNote "Margin values follow ACR TI-RADS 2017: smooth, ill-defined, lobulated or irregular, extra-thyroidal extension. Lobulated and irregular are one scoring category in the scheme and are kept separate here, because a radiologist can say which and the scheme discarding that is the scheme's choice, not ours. Spiculated is subsumed under irregular, which TI-RADS defines as jagged, spiculated or sharp angles." ;
                  cde:hasBinding cde:binding-ThyroidNodule-RADLEX-RID50509 ,
                                 cde:binding-ThyroidNodule-SNOMEDCT-237495005 ;
                  cde:lastModified "2026-09-10"^^xsd:date ;
                  cde:localId "FC-000010" ;
                  cde:nodeType "FindingClass" ;
                  cde:versionNumber 1 ;
                  cde:versionStatus "proposed" .

