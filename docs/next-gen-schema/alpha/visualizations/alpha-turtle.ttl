                                  owl:onProperty cde:seenOn ;
                                  owl:someValuesFrom cde:XR
                                ] ;
                rdfs:label "renal lesion" ;
                skos:definition "A focal abnormality of the renal parenchyma, not further characterised." ;
                skos:prefLabel "renal lesion" ;
                cde:anchorBase <http://radlex.org/RID/RID38780> ;
