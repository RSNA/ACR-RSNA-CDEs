###  https://radelement.org/ng/SolidComponentOfPartSolidNodule
cde:SolidComponentOfPartSolidNodule rdf:type owl:Class ;
                                    rdfs:subClassOf cde:FindingClass ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cde:componentOf ;
                                                      owl:someValuesFrom cde:PartSolidPulmonaryNodule
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cde:hasAttenuation ;
                                                      owl:someValuesFrom cde:V_000010_Solid
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cde:hasMeasurement ;
                                                      owl:someValuesFrom cde:SolidComponentDiameter
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cde:hasPresence ;
                                                      owl:someValuesFrom cde:PresenceValue
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cde:seenOn ;
                                                      owl:someValuesFrom cde:CT
                                                    ] ;
                                    rdfs:label "solid component of part-solid pulmonary nodule" ;
                                    skos:definition "The solid portion of a part-solid pulmonary nodule." ;
                                    skos:exactMatch <http://radlex.org/RID/RID50154> ;
                                    skos:prefLabel "solid component of part-solid pulmonary nodule" ;
                                    cde:anchorVerdict "anchored" ;
                                    cde:conceptSource "Cancer Care Ontario" ;
                                    cde:created "2026-09-10"^^xsd:date ;
                                    cde:designNote "Attenuation is fixed to solid as a class axiom, not offered as an element: nobody chooses it, and a single-value element would be a definition wearing an element. The axiom is what lets a report stating both part-solid and solid resolve, because the two values then sit on two entities rather than one." ;
                                    cde:hasBinding cde:binding-SolidComponentOfPartSolidNodule-RADLEX-RID50154 ;
                                    cde:isComponent "true"^^xsd:boolean ;
                                    cde:lastModified "2026-09-10"^^xsd:date ;
                                    cde:localId "FC-000009" ;
                                    cde:nodeType "FindingClass" ;
                                    cde:versionNumber 1 ;
                                    cde:versionStatus "proposed" .


