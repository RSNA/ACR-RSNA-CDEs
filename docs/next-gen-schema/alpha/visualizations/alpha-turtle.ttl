   owl:annotatedSource cde:GroundGlassOpacity ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid308 ;
   cde:designNote "SCOPED_TO kind=specific" ;
   cde:scopeStrength "required" ;
   cde:source "local"
 ] .


###  https://radelement.org/ng/HeartFailure
cde:HeartFailure rdf:type owl:Class ;
                 rdfs:subClassOf cde:Diagnosis ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cde:hasPresence ;
                                   owl:someValuesFrom cde:PresenceValue
                                 ] ,
                                 _:genid315 ,
                                 _:genid317 ;
                 rdfs:label "heart failure" ;
                 skos:definition "Inability of the heart to maintain adequate output, with venous congestion." ;
                 skos:exactMatch <http://radlex.org/RID/RID34795> ,
                                 <http://snomed.info/id/84114007> ;
                 skos:prefLabel "heart failure" ;
                 cde:anchorVerdict "anchored" ;
                 cde:conceptSource "Playbook" ;
                 cde:created "2026-09-10"^^xsd:date ;
                 cde:designNote "Causes the oedema rather than manifesting as it: heart failure raises left atrial pressure and fluid accumulates, which is production of a second entity. Nothing here shows itself as anything, which is why it has no manifestation edge at all. Carried as a node so causal edges have a target; it has no imaging elements of its own and is not something a radiologist reports seeing." ;
                 cde:hasBinding cde:binding-HeartFailure-RADLEX-RID34795 ,
                                cde:binding-HeartFailure-SNOMEDCT-84114007 ;
                 cde:lastModified "2026-09-10"^^xsd:date ;
                 cde:localId "DX-000015" ;
                 cde:noImagingElements "true"^^xsd:boolean ;
                 cde:nodeType "Diagnosis" ;
                 cde:versionNumber 1 ;
                 cde:versionStatus "proposed" .

