                                    rdfs:subClassOf cde:VascularTerritoryValue ;
                                    owl:disjointWith cde:V_000361_MiddleCerebralArtery ,
                                                     cde:V_000362_PosteriorCerebralArtery ,
                                                     cde:V_000363_PosteriorCirculation ,
                                                     cde:V_000364_Watershed ,
                                                     cde:V_000365_NonTerritorial ;
                                    rdfs:label "anterior cerebral artery" ;
                                    skos:definition "Parasagittal frontal and medial parietal." ;
                                    skos:exactMatch <http://radlex.org/RID/RID648> ;
                                    skos:prefLabel "anterior cerebral artery" ;
                                    cde:created "2026-09-10"^^xsd:date ;
