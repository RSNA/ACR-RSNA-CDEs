###  https://radelement.org/ng/RibFracture
cde:RibFracture rdf:type owl:Class ;
                rdfs:subClassOf cde:FindingClass ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasAcuity ;
                                  owl:someValuesFrom cde:AcuityValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasComminution ;
                                  owl:someValuesFrom cde:ComminutionValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasFractureDisplacement ;
                                  owl:someValuesFrom cde:FractureDisplacementValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasIntervalChange ;
                                  owl:someValuesFrom cde:IntervalChangeValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasLaterality ;
                                  owl:someValuesFrom cde:LateralityValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasMeasurement ;
                                  owl:someValuesFrom cde:DisplacementDistance
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:hasPresence ;
                                  owl:someValuesFrom cde:PresenceValue
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:inSubspecialty ;
                                  owl:someValuesFrom cde:SP_CH
                                ] ,
                                _:genid803 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:seenOn ;
                                  owl:someValuesFrom cde:CT
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:seenOn ;
                                  owl:someValuesFrom cde:MR
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:seenOn ;
                                  owl:someValuesFrom cde:US
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cde:seenOn ;
                                  owl:someValuesFrom cde:XR
                                ] ;
                rdfs:label "rib fracture" ;
                skos:definition "A break in the cortex of a rib." ;
                skos:prefLabel "rib fracture" ;
                cde:anchorBase <http://radlex.org/RID/RID4650> ;
                cde:anchorModifier <http://radlex.org/RID/RID2471> ;
                cde:anchorVerdict "post_coordinated" ;
                cde:created "2026-09-10"^^xsd:date ;
                cde:designNote "Acuity is the question in trauma: acute, healing, healed, or of indeterminate age. Displacement and comminution matter far less. Plurality is the unhandled part: reports say 'fractures of the left fourth through seventh ribs' and the model has no way to hold a set." ;
                cde:lastModified "2026-09-10"^^xsd:date ;
                cde:localId "FC-000037" ;
                cde:narrowsTo "acuity: V_000330_Acute, V_000332_Healing, V_000333_Healed, V_000335_IndeterminateAge" ;
                cde:nodeType "FindingClass" ;
                cde:source "local" ;
                cde:sourceStatus "unrequested" ;
                cde:versionNumber 1 ;
                cde:versionStatus "proposed" .

