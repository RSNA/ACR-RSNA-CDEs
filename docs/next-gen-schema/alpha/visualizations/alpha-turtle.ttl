###  https://radelement.org/ng/V_000430_Laminar
cde:V_000430_Laminar rdf:type owl:Class ;
                     rdfs:subClassOf cde:FlowCharacterValue ;
                     owl:disjointWith cde:V_000431_Turbulent ;
                     rdfs:label "laminar" ;
                     skos:definition "Ordered flow, uniform colour." ;
