                         rdfs:label "peak systolic velocity" ;
                         skos:definition "The highest flow velocity reached during systole in the segment." ;
                         cde:created "2026-09-10"^^xsd:date ;
                         cde:designNote "The axis the external carotid is graded on. Diameter ratios are not used there: the vessel is small and tortuous and the ratio is unreliable, so velocity carries the judgement instead." ;
                         cde:lastModified "2026-09-10"^^xsd:date ;
                         cde:localId "MS-000017" ;
                         cde:measurementMethod "Angle-corrected spectral Doppler at the point of maximal narrowing, insonation angle 60 degrees or less." ;
                         cde:nodeType "Measurement" ;
                         cde:permittedUnit "cm/s" ;
                         cde:quantityKind "velocity" ;
                         cde:versionNumber 1 ;
                         cde:versionStatus "proposed" .


