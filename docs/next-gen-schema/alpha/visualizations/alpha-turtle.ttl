###  https://radelement.org/ng/V_000321_LargeCometTailArtifact
cde:V_000321_LargeCometTailArtifact rdf:type owl:Class ;
                                    rdfs:subClassOf cde:EchogenicFociValue ;
                                    owl:disjointWith cde:V_000322_Macrocalcifications ,
                                                     cde:V_000323_PeripheralRimCalcifications ,
                                                     cde:V_000324_PunctateEchogenicFoci ;
                                    rdfs:label "large comet-tail artifact" ;
                                    skos:definition "V-shaped reverberation artifact greater than 1 mm in a cystic component. Indicates colloid and is a benign feature." ;
                                    skos:exactMatch <http://radlex.org/RID/RID49887> ;
                                    skos:prefLabel "large comet-tail artifact" ;
                                    cde:conceptSource "TI-RADS" ;
                                    cde:created "2026-09-10"^^xsd:date ;
                                    cde:hasBinding cde:binding-V_000321_LargeCometTailArtifact-RADLEX-RID49887 ;
                                    cde:lastModified "2026-09-10"^^xsd:date ;
                                    cde:localId "V-000321" ;
                                    cde:nodeType "Value" ;
                                    cde:rank 2 ;
                                    cde:sourceDefinition """TI-RADS: Comet-tail artifacts: A comet-tail artifact is a type of
reverberation artifact. The deeper echoes become attenuated and are displayed as decreased width, resulting in a triangular shape. If an echogenic focus does not have this feature, a comet-tail artifact should not be described.""" ;
                                    cde:versionNumber 1 ;
                                    cde:versionStatus "proposed" .


###  https://radelement.org/ng/V_000322_Macrocalcifications
cde:V_000322_Macrocalcifications rdf:type owl:Class ;
                                 rdfs:subClassOf cde:EchogenicFociValue ;
                                 owl:disjointWith cde:V_000323_PeripheralRimCalcifications ,
                                                  cde:V_000324_PunctateEchogenicFoci ;
                                 rdfs:label "macrocalcifications" ;
                                 skos:definition "Coarse calcification causing acoustic shadowing." ;
                                 skos:exactMatch <http://radlex.org/RID/RID34369> ;
                                 skos:prefLabel "macrocalcifications" ;
                                 cde:conceptSource "BI-RADS 4, TI-RADS" ;
                                 cde:created "2026-09-10"^^xsd:date ;
                                 cde:hasBinding cde:binding-V_000322_Macrocalcifications-RADLEX-RID34369 ;
                                 cde:lastModified "2026-09-10"^^xsd:date ;
                                 cde:localId "V-000322" ;
                                 cde:nodeType "Value" ;
                                 cde:rank 3 ;
                                 cde:sourceDefinition "BI-RADS US:Macrocalcifcations are coarse calcifications that are 0.5mm or greater in size.  As in other areas of the body, macrocalcifications will attenuate the acoustic beam and cause acoustic shadowing." ;
                                 cde:versionNumber 1 ;
                                 cde:versionStatus "proposed" .


