            rdfs:subPropertyOf cde:actsOn ;
            rdfs:comment "Extends into and disrupts a structure." .


###  https://radelement.org/ng/mayBeCausedBy
cde:mayBeCausedBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf cde:mayCause ;
                  rdfs:comment "Inverse of mayCause." ;
                  cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayBeRelatedTo
cde:mayBeRelatedTo rdf:type owl:ObjectProperty ,
                            owl:SymmetricProperty ;
                   rdfs:comment "Symmetric catch-all for an association the author cannot yet type. A triage queue, not a home; every use is a candidate for replacement by a typed edge." ;
                   cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayCause
cde:mayCause rdf:type owl:ObjectProperty ;
             rdfs:comment "Causal. The source can produce the target as a distinct second entity. Distinct from mayManifestAs, which is about evidence rather than production." ;
             cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayManifestAs
cde:mayManifestAs rdf:type owl:ObjectProperty ;
                  owl:inverseOf cde:mayRepresent ;
                  rdfs:comment "Evidential. The diagnosis can show itself as the target. Carries typicality (how often) and specificity (how much seeing it narrows the differential). Annotation-only." ;
                  cde:epistemic "true"^^xsd:boolean ;
                  cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayProgressFrom
cde:mayProgressFrom rdf:type owl:ObjectProperty ;
                    owl:inverseOf cde:mayProgressTo ;
                    rdfs:comment "PROPOSED, NOT ADOPTED. Inverse of mayProgressTo." ;
                    cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayProgressTo
cde:mayProgressTo rdf:type owl:ObjectProperty ;
                  rdfs:comment "PROPOSED, NOT ADOPTED. Identity-preserving evolution: the same entity in a later state. Annotation-only, because the identity claim is not expressible atemporally. See probes C1-C3." ;
                  cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/mayRepresent
cde:mayRepresent rdf:type owl:ObjectProperty ;
                 rdfs:comment "Inverse of mayManifestAs. How a report reads: finding toward conclusion." ;
                 cde:designNote "Inferential reading, one edge. It covers direct appearances and indirect signs alike, and carries no formal semantics, so no reasoner check uses it. Marked epistemic and inferenceBearing false so that is explicit rather than assumed. " ;
                 cde:epistemic "true"^^xsd:boolean ;
                 cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/obstructs
cde:obstructs rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf cde:actsOn ;
              rdfs:comment "Occludes the lumen of a structure." .


###  https://radelement.org/ng/occursWith
cde:occursWith rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:comment "Symmetric and associative. Seen together; asserts and excludes nothing about causality or sequence." ;
               cde:inferenceBearing "false"^^xsd:boolean .


###  https://radelement.org/ng/partOf
cde:partOf rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:comment "Mereological. Transitive." .


