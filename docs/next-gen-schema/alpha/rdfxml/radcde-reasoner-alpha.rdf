    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>complex renal cyst</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b278"/>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b279"/>
