    <rdfs:label>tension pneumothorax</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b496"/>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b497"/>
