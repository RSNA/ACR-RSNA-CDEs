  <rdf:Description rdf:about="https://radelement.org/ng/hasEchogenicity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>echogenicity</rdfs:label>
    <rdfs:domain rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b247"/>
    <rdfs:range rdf:resource="https://radelement.org/ng/EchogenicityValue"/>
    <rdfs:subPropertyOf rdf:resource="https://radelement.org/ng/hasDataElement"/>
    <skos:closeMatch rdf:resource="http://www.radlex.org/RID/RID6045"/>
    <skos:definition>The reflectivity of the lesion relative to the adjacent parenchyma on ultrasound.</skos:definition>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:created>
