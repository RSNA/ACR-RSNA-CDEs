  <rdf:Description rdf:about="https://radelement.org/ng/SolidComponentOfPartSolidNodule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>solid component of part-solid pulmonary nodule</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b180"/>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b181"/>
