  <rdf:Description rdf:about="https://radelement.org/ng/InternalCarotidArteryStenosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>internal carotid artery stenosis</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b87"/>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b88"/>
    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b89"/>
