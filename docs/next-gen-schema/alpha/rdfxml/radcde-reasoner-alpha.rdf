    <rdfs:subClassOf rdf:nodeID="nb9afa65a8aaa4f838d9333ccf47e4216b184"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/FindingClass"/>
    <skos:definition>The solid portion of a part-solid pulmonary nodule.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID50154"/>
    <skos:prefLabel>solid component of part-solid pulmonary nodule</skos:prefLabel>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:created>
    <cde:designNote>Attenuation is fixed to solid as a class axiom, not offered as an element: nobody chooses it, and a single-value element would be a definition wearing an element. The axiom is what lets a report stating both part-solid and solid resolve, because the two values then sit on two entities rather than one.</cde:designNote>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-SolidComponentOfPartSolidNodule-RADLEX-RID50154"/>
    <cde:isComponent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cde:isComponent>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:lastModified>
    <cde:localId>FC-000009</cde:localId>
    <cde:nodeType>FindingClass</cde:nodeType>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
  </rdf:Description>
