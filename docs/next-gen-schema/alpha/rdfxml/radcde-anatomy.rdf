  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID29530">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID29529"/>
    <rdfs:label>body compartment subdivision</rdfs:label>
    <skos:prefLabel>body compartment subdivision</skos:prefLabel>
    <skos:definition>Compartment of trunk which is enclosed by a body wall subdivision and is demarcated from another body cavity subdivision by an anatomical structure or a conduit, it contains one or more serous sacs, viscera and other organs; together with the other body cavity subdivisions, it constitutes the body cavity. Examples: thoracic cavity, abdominopelvic cavity, abdominal cavity, pelvic cavity.</skos:definition>
    <cde:localId>AL-000161</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID29530-RADLEX-RID29530"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID29530"/>
    <cde:sourceDefinition>Compartment of trunk which is enclosed by a body wall subdivision and is demarcated from another body cavity subdivision by an anatomical structure or a conduit, it contains one or more serous sacs, viscera and other organs; together with the other body cavity subdivisions, it constitutes the body cavity. Examples: thoracic cavity, abdominopelvic cavity, abdominal cavity, pelvic cavity.</cde:sourceDefinition>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>published</cde:versionStatus>
