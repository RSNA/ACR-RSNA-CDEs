    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID13391"/>
    <rdfs:label>parenchyma</rdfs:label>
    <skos:prefLabel>parenchyma</skos:prefLabel>
    <skos:definition>Organ component constituted by specialized tissues which are organized into acini, lobules, segments, and lobes, or corticomedullary units and supported by stroma. Examples: parenchyma of lung, parenchyma of liver, parenchyma of kidney.</skos:definition>
    <cde:localId>AL-000060</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
