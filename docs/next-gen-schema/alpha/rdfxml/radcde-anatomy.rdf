  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID29840">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID13404"/>
    <rdfs:label>trunk proper</rdfs:label>
    <skos:prefLabel>trunk proper</skos:prefLabel>
    <skos:definition>Subdivision of trunk which is demarcated from the back of trunk by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall and from the limbs by the inguinal folds; together with the back of trunk, it constitutes the trunk. Examples: There is only one trunk proper.</skos:definition>
    <cde:localId>AL-000164</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID29840-RADLEX-RID29840"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID29840"/>
    <cde:hasSynonym rdf:nodeID="N97c72fa69b72471da02fb576c84ac825"/>
    <skos:altLabel>trunk front</skos:altLabel>
    <cde:sourceDefinition>Subdivision of trunk which is demarcated from the back of trunk by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall and from the limbs by the inguinal folds; together with the back of trunk, it constitutes the trunk. Examples: There is only one trunk proper.</cde:sourceDefinition>
