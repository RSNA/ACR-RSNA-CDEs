  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID13214">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID13390"/>
    <rdfs:label>cardinal organ part</rdfs:label>
    <skos:prefLabel>cardinal organ part</skos:prefLabel>
    <skos:definition>Anatomical structure which has as its direct parts two or more types of tissue and is continuous with one or more anatomical structures likewise constituted by two or more portions of tissues distinct from those of their complement. Examples: osteon, cortical bone, neck of femur, bronchopulmonary segment, left lobe of liver, anterior right side of heart, interventricular branch of left coronary artery, right atrium, mitral valve, head of pancreas.</skos:definition>
    <cde:localId>AL-000095</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID13214-RADLEX-RID13214"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID13214"/>
    <skos:altLabel xml:lang="la">organteil</skos:altLabel>
    <cde:sourceDefinition>Anatomical structure which has as its direct parts two or more types of tissue and is continuous with one or more anatomical structures likewise constituted by two or more portions of tissues distinct from those of their complement. Examples: osteon, cortical bone, neck of femur, bronchopulmonary segment, left lobe of liver, anterior right side of heart, interventricular branch of left coronary artery, right atrium, mitral valve, head of pancreas.</cde:sourceDefinition>
