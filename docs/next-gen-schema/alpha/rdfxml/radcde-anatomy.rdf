  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID28902"/>
    <rdfs:subClassOf rdf:nodeID="N8048c2fa61cc43a0af1a0fec0c0d3c06"/>
    <rdfs:label>adrenal gland</rdfs:label>
    <skos:prefLabel>adrenal gland</skos:prefLabel>
    <skos:definition>A pair of glands located at the cranial pole of each of the two kidneys. Each adrenal gland is composed of two distinct endocrine tissues with separate embryonic origins, the adrenal cortex producing steroids and the adrenal medulla producing neurotransmitters. [MeSH]</skos:definition>
    <cde:localId>AL-000008</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID88-RADLEX-RID88"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID88-SNOMEDCT-23451007"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID88"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/23451007"/>
    <skos:altLabel xml:lang="la">glandula suprarenalis</skos:altLabel>
    <cde:sourceDefinition>A pair of glands located at the cranial pole of each of the two kidneys. Each adrenal gland is composed of two distinct endocrine tissues with separate embryonic origins, the adrenal cortex producing steroids and the adrenal medulla producing neurotransmitters. [MeSH]</cde:sourceDefinition>
    <cde:conceptSource>Playbook</cde:conceptSource>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
