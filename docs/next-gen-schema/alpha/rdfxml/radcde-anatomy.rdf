  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID7124">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID7123"/>
    <rdfs:subClassOf rdf:nodeID="Nf56112cb6ea64ce1b8c3ea3f2e6cbb84"/>
    <rdfs:label>lateral ventricle</rdfs:label>
    <skos:prefLabel>lateral ventricle</skos:prefLabel>
    <skos:definition>Cavity in each of the cerebral hemispheres derived from the cavity of the embryonic neural tube. They are separated from each other by the septum pellucidum, and each communicates with the third ventricle by the foramen of Monro, through which also the choroid plexuses (choroid plexus) of the lateral ventricles become continuous with that of the third ventricle. [MeSH]</skos:definition>
    <cde:localId>AL-000074</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID7124-RADLEX-RID7124"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID7124"/>
    <cde:sourceDefinition>Cavity in each of the cerebral hemispheres derived from the cavity of the embryonic neural tube. They are separated from each other by the septum pellucidum, and each communicates with the third ventricle by the foramen of Monro, through which also the choroid plexuses (choroid plexus) of the lateral ventricles become continuous with that of the third ventricle. [MeSH]</cde:sourceDefinition>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>published</cde:versionStatus>
