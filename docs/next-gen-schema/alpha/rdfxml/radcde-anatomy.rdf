  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID7578">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID13419"/>
    <rdfs:subClassOf rdf:nodeID="Nd98947c6ab1849e293e1a4b890541094"/>
    <rdfs:subClassOf rdf:nodeID="N789675950295421f8fec0b7895a2923c"/>
    <rdfs:label>thyroid gland</rdfs:label>
    <skos:prefLabel>thyroid gland</skos:prefLabel>
    <skos:definition>A highly vascularized endocrine gland consisting of two lobes joined by a thin band of tissue with one lobe on each side of the trachea. It secretes thyroid hormones from the follicular cells and calcitonin from the parafollicular cells thereby regulating metabolism and calcium level in blood, respectively. [MeSH]</skos:definition>
    <cde:localId>AL-000078</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID7578-RADLEX-RID7578"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID7578-SNOMEDCT-69748006"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID7578"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/69748006"/>
    <cde:hasSynonym rdf:nodeID="N93e203f186e74606ac392a987b7159fc"/>
    <skos:altLabel>thyroid</skos:altLabel>
    <skos:altLabel xml:lang="la">glandula thyroidea</skos:altLabel>
    <cde:sourceDefinition>A highly vascularized endocrine gland consisting of two lobes joined by a thin band of tissue with one lobe on each side of the trachea. It secretes thyroid hormones from the follicular cells and calcitonin from the parafollicular cells thereby regulating metabolism and calcium level in blood, respectively. [MeSH]</cde:sourceDefinition>
    <cde:conceptSource>Playbook</cde:conceptSource>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
