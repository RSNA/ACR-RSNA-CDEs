  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID92">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID5988"/>
    <rdfs:subClassOf rdf:nodeID="N4375b798084849b3a47970c81ccf61af"/>
    <rdfs:label>cortex of adrenal gland</rdfs:label>
    <skos:prefLabel>cortex of adrenal gland</skos:prefLabel>
    <skos:definition>The outer layer of the adrenal gland. It is derived from mesoderm and comprised of three zones (outer zona glomerulosa, middle zona fasciculata, and inner zona reticularis) with each producing various steroids preferentially, such as aldosterone; hydrocortisone; dehydroepiandrosterone; and androstenedione. Adrenal cortex function is regulated by pituitary adrenocorticotropin. [MeSH]</skos:definition>
    <cde:localId>AL-000010</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID92-RADLEX-RID92"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID92"/>
    <cde:hasSynonym rdf:nodeID="Nac66384695f44b46b495cc8b2b11081b"/>
    <cde:hasSynonym rdf:nodeID="N09c5f376f5814317aeb7f5c34ae9e08f"/>
    <skos:altLabel>cortex of suprarenal gland</skos:altLabel>
    <skos:altLabel>adrenal cortex</skos:altLabel>
    <skos:altLabel xml:lang="la">cortex glandulae suprarenalis</skos:altLabel>
    <cde:sourceDefinition>The outer layer of the adrenal gland. It is derived from mesoderm and comprised of three zones (outer zona glomerulosa, middle zona fasciculata, and inner zona reticularis) with each producing various steroids preferentially, such as aldosterone; hydrocortisone; dehydroepiandrosterone; and androstenedione. Adrenal cortex function is regulated by pituitary adrenocorticotropin. [MeSH]</cde:sourceDefinition>
