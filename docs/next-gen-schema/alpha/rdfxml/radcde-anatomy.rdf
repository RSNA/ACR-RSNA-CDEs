  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID28538">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID1296"/>
    <rdfs:label>airspace</rdfs:label>
    <skos:prefLabel>airspace</skos:prefLabel>
    <skos:definition>Anatomy.—An airspace is the gas-containing part of the lung, including the respiratory bronchioles but excluding purely conducting airways, such as terminal bronchioles. 
Radiographs and CT scans.—This term is used in conjunction with consolidation, opacity, and nodules to designate the filling of airspaces with the products of disease (14).  [Fleischner Society]</skos:definition>
    <cde:localId>AL-000149</cde:localId>
    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RID28538-RADLEX-RID28538"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID28538"/>
    <cde:sourceDefinition>Anatomy.—An airspace is the gas-containing part of the lung, including the respiratory bronchioles but excluding purely conducting airways, such as terminal bronchioles. 
Radiographs and CT scans.—This term is used in conjunction with consolidation, opacity, and nodules to designate the filling of airspaces with the products of disease (14).  [Fleischner Society]</cde:sourceDefinition>
    <cde:conceptSource>Fleischner Society</cde:conceptSource>
