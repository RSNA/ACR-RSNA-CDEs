    <rdfs:subClassOf rdf:nodeID="N94e70eec69584c5ba6dc11a6ba662a0c"/>
    <rdfs:label>renal cell carcinoma</rdfs:label>
    <skos:prefLabel>renal cell carcinoma</skos:prefLabel>
    <skos:definition>A primary malignant neoplasm arising from renal tubular epithelium.</skos:definition>
    <cde:localId>DX-000023</cde:localId>
    <cde:nodeType>Diagnosis</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RenalCellCarcinoma-RADLEX-RID4230"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-RenalCellCarcinoma-SNOMEDCT-702391001"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID4230"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/702391001"/>
    <cde:synonymOnlyHit rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cde:synonymOnlyHit>
    <cde:hasSynonym rdf:nodeID="Nb6b0aa567fef45b0b64c77dbee9d8641"/>
    <cde:hasSynonym rdf:nodeID="N18534578d4a745f3b7a6f939aa45e3d9"/>
    <skos:altLabel>RCC</skos:altLabel>
    <skos:altLabel>hypernephroma</skos:altLabel>
    <cde:anchorVerdict>anchored</cde:anchorVerdict>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
    <cde:sourceDefinition>A heterogeneous group of sporadic or hereditary carcinoma derived from cells of the kidneys. There are several subtypes including the clear cells, the papillary, the chromophobe, the collecting duct, the spindle cells (sarcomatoid), or mixed cell-type carcinoma. [MeSH]</cde:sourceDefinition>
  </rdf:Description>
