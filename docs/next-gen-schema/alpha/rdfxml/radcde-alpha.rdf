    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>complex renal cyst</rdfs:label>
    <skos:prefLabel>complex renal cyst</skos:prefLabel>
    <skos:definition>A renal cyst whose contents are not uniformly fluid.</skos:definition>
    <cde:localId>FC-000015</cde:localId>
    <cde:nodeType>FindingClass</cde:nodeType>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/RenalCyst"/>
