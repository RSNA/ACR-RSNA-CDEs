    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/ThyroidMarginValue"/>
    <rdfs:label>irregular</rdfs:label>
    <skos:prefLabel>irregular</skos:prefLabel>
    <skos:definition>Jagged, spiculated or with sharp angles.</skos:definition>
    <cde:localId>V-000393</cde:localId>
    <cde:nodeType>Value</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-V_000393_Irregular-RADLEX-RID5715"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID5715"/>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
