  <rdf:Description rdf:about="https://radelement.org/ng/scopedToRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Scope checked by containment along partOf. kind=region.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://radelement.org/ng/scopedTo"/>
    <owl:propertyChainAxiom rdf:nodeID="Nd8c4a1c034cf4d44a6432c8606df0b47"/>
    <cde:designNote>Property chain scopedToRegion o partOf -&gt; scopedToRegion. A finding scoped to a lobe is thereby scoped to the lung, without every combination being written out. This is the mechanism behind decision-register item 3, anatomic scope stored or inferred.</cde:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://radelement.org/ng/RenalCellCarcinoma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/Diagnosis"/>
    <rdfs:subClassOf rdf:nodeID="Nadb262cb715942728b02df3cecf4e0da"/>
