  <rdf:Description rdf:about="https://radelement.org/ng/PleuralEffusion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>pleural effusion</rdfs:label>
    <skos:prefLabel>pleural effusion</skos:prefLabel>
    <skos:definition>Fluid within the pleural space beyond the physiologic few millilitres.</skos:definition>
    <cde:localId>FC-000021</cde:localId>
    <cde:nodeType>FindingClass</cde:nodeType>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/FindingClass"/>
    <rdfs:subClassOf rdf:nodeID="Nf0d0d248eb504af29932bc68806ede66"/>
    <rdfs:subClassOf rdf:nodeID="N72367048d8ed4ae9af70fe34cd2fb760"/>
    <rdfs:subClassOf rdf:nodeID="N7ed37a9c82d84abf9d6d617839c0c728"/>
    <rdfs:subClassOf rdf:nodeID="N8ba946d6d5c04b81bfebd0f9f398e26a"/>
    <rdfs:subClassOf rdf:nodeID="Nf9aac7d732ef45188dae13f52912264c"/>
    <rdfs:subClassOf rdf:nodeID="Nc5bc9c4d36524389bca468b2be998f6e"/>
    <rdfs:subClassOf rdf:nodeID="N9cdba9042ac84594b0ada7076bfb0b08"/>
    <rdfs:subClassOf rdf:nodeID="Nb9b292b60f65412a98ec03fcb1723d65"/>
    <rdfs:subClassOf rdf:nodeID="N6b41ce9eddca43c2abf5818a65e9fedc"/>
    <rdfs:subClassOf rdf:nodeID="N804070b32d674ca0a4a6449dd45760ae"/>
    <rdfs:subClassOf rdf:nodeID="Nd5dfbd229af345fba5675ead36c51a6e"/>
    <rdfs:subClassOf rdf:nodeID="N13bdddc1a7b347fd897c4011317b71fb"/>
    <rdfs:subClassOf rdf:nodeID="Nb82f35b34d0643078c4a5a8607828cc9"/>
    <rdfs:subClassOf rdf:nodeID="N65f2818abc54466f8c1aa43df34c8f6d"/>
    <rdfs:subClassOf rdf:nodeID="N3316235a471d423e869e14461a6c26a5"/>
    <rdfs:subClassOf rdf:nodeID="N67110d24809e40859f3b3ceee9a102e8"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-PleuralEffusion-RADLEX-RID34539"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-PleuralEffusion-SNOMEDCT-60046008"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID34539"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/60046008"/>
    <cde:hasSynonym rdf:nodeID="N8e7cb61f38884b15a4d0e05b09650f0e"/>
    <cde:hasSynonym rdf:nodeID="Nb89e2a270a0e4dc39213da31635ce453"/>
    <skos:altLabel>pleural fluid</skos:altLabel>
    <skos:altLabel>effusion</skos:altLabel>
    <cde:designNote>The first non-focal finding in the build. No margin, no size measurement, no distribution. Amount, attenuation and internal complexity instead. Its co-occurrences are the honest statement where no causal or evidential claim is warranted: an effusion is often seen with these, and saying which produced which would be guessing. Stored once, symmetric.</cde:designNote>
    <cde:anchorVerdict>anchored</cde:anchorVerdict>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
    <cde:conceptSource>Playbook</cde:conceptSource>
  </rdf:Description>
