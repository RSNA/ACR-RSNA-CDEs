    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/Diagnosis"/>
    <rdfs:subClassOf rdf:nodeID="N5c7641c118184e8fa5d1c2b3c5d6c296"/>
    <rdfs:subClassOf rdf:nodeID="N4d391ce9758c4bcbaec415ed8a0c22f5"/>
    <rdfs:subClassOf rdf:nodeID="N16cd71352bfd4f96a0df4ad7ed9d7510"/>
    <rdfs:subClassOf rdf:nodeID="Nb530f7c925ff423783c4c191a4677d40"/>
    <rdfs:label>empyema</rdfs:label>
    <skos:prefLabel>empyema</skos:prefLabel>
    <skos:definition>Infected pleural fluid: pus in the pleural space.</skos:definition>
    <cde:localId>DX-000011</cde:localId>
    <cde:nodeType>Diagnosis</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-Empyema-RADLEX-RID3714"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-Empyema-SNOMEDCT-58554001"/>
    <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID3714"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/58554001"/>
    <cde:hasSynonym rdf:nodeID="N8f453ed22db34ba9aa6dec6d6353e16f"/>
    <skos:altLabel>pleural empyema</skos:altLabel>
    <cde:designNote>Modelled as a Diagnosis that manifests as a pleural effusion with typicality obligate, not as a subtype of the finding. 'Empyema without effusion' is not a meaningful sentence, and obligate is how that is said without collapsing the finding and diagnosis layers.</cde:designNote>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:created>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:lastModified>
  </rdf:Description>
