  <rdf:Description rdf:about="https://radelement.org/ng/PET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/Modality"/>
    <rdfs:label>Positron Emission Tomography</rdfs:label>
    <cde:localId>PET</cde:localId>
    <cde:nodeType>Modality</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-PET-RADLEX-RID10337"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID10337"/>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>published</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
    <cde:conceptSource>Playbook</cde:conceptSource>
    <cde:sourceDefinition>An imaging technique using compounds labelled with short-lived positron-emitting radionuclides (such as carbon-11, nitrogen-13, oxygen-15 and fluorine-18) to measure cell metabolism. It has been useful in study of soft tissues such as cancer; cardiovascular system; and brain. SPECT is closely related to PET, but uses isotopes with longer half-lives and resolution is lower. [MeSH]</cde:sourceDefinition>
  </rdf:Description>
