  <rdf:Description rdf:about="https://radelement.org/ng/hasEchogenicFoci">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://radelement.org/ng/hasDataElement"/>
    <rdfs:label>echogenic foci</rdfs:label>
    <rdfs:range rdf:resource="https://radelement.org/ng/EchogenicFociValue"/>
    <skos:definition>Bright foci within a nodule on ultrasound. Not a synonym for calcification: a comet-tail artifact is a reverberation artifact in colloid, not calcium, and is a reassuring feature.</skos:definition>
    <cde:localId>DE-000033</cde:localId>
    <cde:nodeType>DataElement</cde:nodeType>
    <cde:selectCardinality>multi</cde:selectCardinality>
    <cde:designNote>Multi-select. ACR TI-RADS is explicit that more than one may apply and that their points are additive; it is the only one of its five categories that works this way.</cde:designNote>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
