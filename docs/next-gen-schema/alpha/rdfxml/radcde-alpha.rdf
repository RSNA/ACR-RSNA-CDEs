  <rdf:Description rdf:about="https://radelement.org/ng/V_000360_AnteriorCerebralArtery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/VascularTerritoryValue"/>
    <rdfs:label>anterior cerebral artery</rdfs:label>
    <skos:prefLabel>anterior cerebral artery</skos:prefLabel>
    <skos:definition>Parasagittal frontal and medial parietal.</skos:definition>
    <cde:localId>V-000360</cde:localId>
    <cde:nodeType>Value</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-V_000360_AnteriorCerebralArtery-RADLEX-RID648"/>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID648"/>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
