    <rdfs:subClassOf rdf:nodeID="N7193e56d193f4774945277673040adcf"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-PleuralEffusion-RADLEX-RID34539"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-PleuralEffusion-SNOMEDCT-60046008"/>
