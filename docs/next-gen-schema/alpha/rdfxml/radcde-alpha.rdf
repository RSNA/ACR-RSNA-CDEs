  <rdf:Description rdf:about="https://radelement.org/ng/TensionPneumothorax">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/Diagnosis"/>
    <rdfs:subClassOf rdf:nodeID="N101113a2dbbf422eb79c80f371e072f2"/>
    <rdfs:subClassOf rdf:nodeID="N31d96d058adb46a9a9807e6f7a6532e6"/>
    <rdfs:subClassOf rdf:nodeID="N0807deb080a74569961f06fc69ab5d98"/>
    <rdfs:subClassOf rdf:nodeID="N936dcadfc1a24e8793545557819d55a5"/>
    <rdfs:subClassOf rdf:nodeID="N4575440e9ca540f18d2342f1dac63879"/>
    <rdfs:subClassOf rdf:nodeID="N7dc27f8caf3843db8226bdfee3ef8fce"/>
    <rdfs:subClassOf rdf:nodeID="N618899bffd814598825db4b376caf356"/>
    <rdfs:label>tension pneumothorax</rdfs:label>
    <skos:prefLabel>tension pneumothorax</skos:prefLabel>
    <skos:definition>A pneumothorax under positive pressure, displacing the mediastinum and impairing venous return. A physiological state concluded from imaging signs together with the clinical picture, not a feature seen directly.</skos:definition>
    <cde:localId>DX-000027</cde:localId>
    <cde:nodeType>Diagnosis</cde:nodeType>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-TensionPneumothorax-RADLEX-RID28525"/>
    <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID28525"/>
    <cde:designNote>No single imaging sign establishes tension. It is a physiological conclusion supported by imaging findings together with the clinical picture, rather than a present/absent attribute of pneumothorax.</cde:designNote>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:created>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</cde:lastModified>
  </rdf:Description>
