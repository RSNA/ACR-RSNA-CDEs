            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        cde:FindingClass ;
    skos:definition "A focal abnormality of the renal parenchyma, not further characterised." ;
    skos:prefLabel "renal lesion" ;
