            owl:someValuesFrom cde:US ] ;
    rdfs:range cde:EchogenicityValue ;
    rdfs:subPropertyOf cde:hasDataElement ;
    skos:closeMatch radlex:RID6045 ;
    skos:definition "The reflectivity of the lesion relative to the adjacent parenchyma on ultrasound." ;
    cde:created "2026-09-14"^^xsd:date ;
