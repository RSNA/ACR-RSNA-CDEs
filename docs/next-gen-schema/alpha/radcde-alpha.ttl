cde:SimpleRenalCyst a owl:Class ;
    rdfs:label "simple renal cyst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        cde:RenalCyst ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cde:RenalCyst [ a owl:Restriction ;
                        owl:onProperty cde:hasComposition ;
                        owl:someValuesFrom cde:V_000050_Cystic ] ) ] ;
    skos:broadMatch radlex:RID49690 ;
    skos:definition "A renal cyst with uniformly fluid contents." ;
    skos:exactMatch sct:77945009 ;
    skos:prefLabel "simple renal cyst" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "Defined class: conditions are necessary and sufficient, so a reasoner classifies into it. Nothing about it is authored twice." ;
    cde:hasBinding cde:binding-SimpleRenalCyst-RADLEX-RID49690,
        cde:binding-SimpleRenalCyst-SNOMEDCT-77945009 ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000016" ;
    cde:nodeType "FindingClass" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:abuts a owl:ObjectProperty ;
    rdfs:comment "Contacts a structure without disrupting it." ;
    rdfs:subPropertyOf cde:actsOn .

cde:allowedAnatomicTarget a owl:AnnotationProperty ;
    rdfs:comment "One exact native RadLex concept explicitly permitted as a refinement target." .

cde:allowedRadLexPredicate a owl:AnnotationProperty ;
    rdfs:comment "One exact native RadLex object property permitted by the rule; multiple values remain distinct." .

cde:assessedByCategory a owl:ObjectProperty .

cde:bindingCode a owl:AnnotationProperty ;
    rdfs:comment "Code in that terminology." .

cde:bindingMatch a owl:AnnotationProperty ;
    rdfs:comment "SKOS mapping strength of the binding." .

cde:bindingSystem a owl:AnnotationProperty ;
    rdfs:comment "Terminology identifier of a binding." .

cde:causesFinding a owl:ObjectProperty ;
    rdfs:comment "A finding downstream of another finding." .

cde:conceptSource a owl:AnnotationProperty ;
    rdfs:comment "The body the source terminology credits for the concept (Fleischner, PI-RADS, LI-RADS...)." .

cde:created a owl:AnnotationProperty ;
    rdfs:comment "Creation date." .

cde:criterion a owl:AnnotationProperty ;
    rdfs:comment "A stated criterion carried as an annotation rather than as a defining condition." .

cde:designNote a owl:AnnotationProperty ;
    rdfs:comment "A note recorded during alpha construction." .

cde:displaces a owl:ObjectProperty ;
    rdfs:comment "Moves a structure from its expected position." ;
    rdfs:subPropertyOf cde:actsOn .

cde:encases a owl:ObjectProperty ;
    rdfs:comment "Surrounds a structure circumferentially." ;
    rdfs:subPropertyOf cde:actsOn .

cde:epistemic a owl:AnnotationProperty ;
    rdfs:comment "True where a relation holds between our knowledge of two things rather than between the things." .

cde:erodes a owl:ObjectProperty ;
    rdfs:comment "Destroys the substance of a structure." ;
    rdfs:subPropertyOf cde:actsOn .

cde:exclusiveValue a owl:AnnotationProperty ;
    rdfs:comment "A value whose selection excludes every sibling. Used for a none option on a multi-select element, where value disjointness alone does not prevent none being asserted alongside a pattern." .

cde:hasAnatomicRefinementRule a owl:AnnotationProperty ;
    rdfs:comment "Links a definition class to a first-class anatomic refinement rule." .

cde:hasBinding a owl:AnnotationProperty .

cde:hasSynonym a owl:AnnotationProperty .

cde:includeTargetDescendants a owl:AnnotationProperty ;
    rdfs:comment "Whether native rdfs:subClassOf descendants are eligible targets." .

cde:includeTargetRoot a owl:AnnotationProperty ;
    rdfs:comment "Whether the taxonomy root itself is an eligible target." .

cde:inferenceBearing a owl:AnnotationProperty ;
    rdfs:comment "False where software must not draw conclusions from this relation." .

cde:invades a owl:ObjectProperty ;
    rdfs:comment "Extends into and disrupts a structure." ;
    rdfs:subPropertyOf cde:actsOn .

cde:isComponent a owl:AnnotationProperty ;
    rdfs:comment "True where the class is reached only through HAS_COMPONENT." .

cde:issuingAuthority a owl:AnnotationProperty ;
    rdfs:comment "The body that issues an assessment scheme." .

cde:lastModified a owl:AnnotationProperty ;
    rdfs:comment "Last modification date." .

cde:localId a owl:AnnotationProperty ;
    rdfs:comment "The type-prefixed identifier of the corresponding node in the definition graph." .

cde:mayBeCausedBy a owl:ObjectProperty ;
    rdfs:comment "Inverse of mayCause." ;
    owl:inverseOf cde:mayCause ;
    cde:inferenceBearing false .

cde:mayBeRelatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Symmetric catch-all for an association the author cannot yet type. A triage queue, not a home; every use is a candidate for replacement by a typed edge." ;
    cde:inferenceBearing false .

cde:mayProgressFrom a owl:ObjectProperty ;
    rdfs:comment "Inverse of mayProgressTo." ;
    owl:inverseOf cde:mayProgressTo ;
    cde:inferenceBearing false .

cde:mayRepresent a owl:ObjectProperty ;
    rdfs:comment "Inverse of mayManifestAs. How a report reads: finding toward conclusion." ;
    owl:inverseOf cde:mayManifestAs ;
    cde:designNote "Inferential reading, one edge. It covers direct appearances and indirect signs alike, and carries no formal semantics, so no reasoner check uses it. Marked epistemic and inferenceBearing false so that is explicit rather than assumed. " ;
    cde:epistemic true ;
    cde:inferenceBearing false .

cde:measuredUnit a owl:DatatypeProperty .

cde:measuredValue a owl:DatatypeProperty .

cde:measurementMethod a owl:AnnotationProperty ;
    rdfs:comment "The convention by which a measurement is taken." .

cde:mentionTerm a owl:AnnotationProperty ;
    rdfs:comment "The term in the source text that a mention names." .

cde:misspelling a owl:AnnotationProperty ;
    rdfs:comment "A misspelling the source records for this concept. Like unsanctionedTerm, a subproperty of the source's Synonym and therefore NOT a synonym." .

cde:modalityRestriction a owl:AnnotationProperty ;
    rdfs:comment "Restricts an element or measurement to a subset of the modalities the finding is seen on." .

cde:narrowsTo a owl:AnnotationProperty ;
    rdfs:comment "The subset of an element's values permitted at this point of use. Advisory in alpha: enforced by lint, not by an axiom." .

cde:noImagingElements a owl:AnnotationProperty ;
    rdfs:comment "True on a diagnosis carried only so causal edges have a target." .

cde:nodeType a owl:AnnotationProperty ;
    rdfs:comment "Which node type of the definition graph this entity serialises." .

cde:obstructs a owl:ObjectProperty ;
    rdfs:comment "Occludes the lumen of a structure." ;
    rdfs:subPropertyOf cde:actsOn .

cde:permittedUnit a owl:AnnotationProperty ;
    rdfs:comment "A UCUM unit code permitted for a measurement." .

cde:quantityKind a owl:AnnotationProperty ;
    rdfs:comment "The kind of quantity a measurement reports." .

cde:radcde-alpha a owl:Ontology ;
    dcterms:title "RadElement next-gen alpha: generated CDE definition layer" ;
    rdfs:comment "A first-pass OWL rendering of the next-generation RadElement definition layer, built to test modelling decisions rather than to publish content. Clinical content is provisional and unvalidated. Every RadLex code was verified against the RadLex 4.3 export." ;
    owl:imports <http://radlex.org/RID/RadLex.owl> ;
    owl:versionInfo "alpha-0.1" .

cde:radlexCompositionBase a owl:AnnotationProperty ;
    rdfs:comment "The RadLex head concept used when a CDE concept is represented compositionally." .

cde:radlexCompositionModifier a owl:AnnotationProperty ;
    rdfs:comment "A RadLex concept that modifies the compositional base." .

cde:rank a owl:AnnotationProperty ;
    rdfs:comment "Position in an ordered value list. Present on every value of an element or on none." .

cde:refinesScope a owl:AnnotationProperty ;
    rdfs:comment "The authored scope entry narrowed by the rule." .

cde:replacedBy a owl:AnnotationProperty ;
    rdfs:comment "Retirement pointer from the source terminology." .

cde:schemeScope a owl:AnnotationProperty ;
    rdfs:comment "observation, exam or side." .

cde:schemeVersion a owl:AnnotationProperty ;
    rdfs:comment "The scheme's own version clock, independent of ours." .

cde:scopeStrength a owl:AnnotationProperty ;
    rdfs:comment "required, expected or unconstrained. Declares how binding a scope claim is." .

cde:selectCardinality a owl:AnnotationProperty ;
    rdfs:comment "single or multi. Single-select elements are declared owl:FunctionalProperty; multi-select ones are not. Value disjointness alone does not give single-select." .

cde:sourceChangeLog a owl:AnnotationProperty ;
    rdfs:comment "The source terminology's own per-concept change history." .

cde:sourceDefinition a owl:AnnotationProperty ;
    rdfs:comment "The source terminology's definition, kept distinct from ours." .

cde:sourceLabel a owl:AnnotationProperty ;
    rdfs:comment "That terminology's label for the code, as of sourceVersion." .

cde:sourceRef a owl:AnnotationProperty ;
    rdfs:comment "Where in the modelling corpus the example came from." .

cde:sourceText a owl:AnnotationProperty ;
    rdfs:comment "Report text an instance example was drawn from." .

cde:sourceVersion a owl:AnnotationProperty ;
    rdfs:comment "Terminology release the binding was resolved against." .

cde:specificity a owl:AnnotationProperty ;
    rdfs:comment "How much seeing the target narrows the differential: suggestive, highly_suggestive, pathognomonic. Read backward, finding to diagnosis." .

cde:synonymOnlyHit a owl:AnnotationProperty ;
    rdfs:comment "True where the RadLex binding is reachable only through the source's synonym field." .

cde:synonymScope a owl:AnnotationProperty ;
    rdfs:comment "exact, narrow, broad or related. Stops a narrow synonym being treated as an exact hit." .

cde:synonymTerm a owl:AnnotationProperty ;
    rdfs:comment "An alternate term for the concept." .

cde:synonymType a owl:AnnotationProperty ;
    rdfs:comment "synonym, abbreviation, acronym or eponym." .

cde:targetTaxonomyRoot a owl:AnnotationProperty ;
    rdfs:comment "Native RadLex taxonomy root used only to define eligible target concepts." .

cde:traversalSpecification a owl:AnnotationProperty ;
    rdfs:comment "Explicit traversal behavior when authored; absence means no traversal behavior has been specified." .

cde:typicality a owl:AnnotationProperty ;
    rdfs:comment "How often the source shows the target: occasional, frequent, very_frequent, obligate. Read forward, diagnosis to finding." .

cde:unsanctionedTerm a owl:AnnotationProperty ;
    rdfs:comment "A term the source terminology explicitly discourages for this concept. NOT a synonym: never emitted as skos:altLabel and never matched by duplicate detection." .

cde:versionNumber a owl:AnnotationProperty ;
    rdfs:comment "Version of this object." .

cde:versionStatus a owl:AnnotationProperty ;
    rdfs:comment "draft, proposed, published, retired or superseded." .

cde:ARR_000001 a owl:NamedIndividual,
        cde:AnatomicRefinementRule ;
    cde:includeTargetDescendants true ;
    cde:includeTargetRoot false ;
    cde:refinesScope radlex:RID1301 ;
    cde:targetTaxonomyRoot radlex:RID34694 .

cde:AdrenalAdenoma a owl:Class ;
    rdfs:label "adrenal adenoma" ;
    rdfs:subClassOf _:N21b61e2485924df898678e1c0c35b8a8,
        [ a owl:Restriction ;
            owl:onProperty cde:hasEtiology ;
            owl:someValuesFrom cde:Neoplastic ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:scopedToSpecific ;
            owl:someValuesFrom radlex:RID92 ],
        cde:Diagnosis ;
    skos:broadMatch radlex:RID4211 ;
    skos:definition "A benign neoplasm of the adrenal cortex." ;
    skos:exactMatch sct:255036008 ;
    skos:prefLabel "adrenal adenoma" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:hasBinding cde:binding-AdrenalAdenoma-RADLEX-RID4211,
        cde:binding-AdrenalAdenoma-SNOMEDCT-255036008 ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "DX-000008" ;
