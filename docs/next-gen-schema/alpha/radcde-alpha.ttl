@prefix anat: <https://radelement.org/ng/anatomy/> .
@prefix cde: <https://radelement.org/ng/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix radlex: <http://radlex.org/RID/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cde:BIRADS a owl:Class ;
    rdfs:label "BI-RADS assessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_5 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_3 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_6 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_4 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_2 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_1 ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCategory ;
            owl:someValuesFrom cde:BIRADS_BI_RADS_0 ],
        cde:AssessmentScheme ;
    skos:exactMatch radlex:RID36027 ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-BIRADS-RADLEX-RID36027 ;
    cde:issuingAuthority "American College of Radiology" ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "AS-000005" ;
    cde:nodeType "AssessmentScheme" ;
    cde:schemeScope "exam" ;
    cde:schemeVersion "5th edition" ;
    cde:sourceDefinition "Breast Imaging Reporting & Data System by American College of Radiology (ACR)" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:Degenerative a owl:Class ;
    rdfs:label "degenerative" ;
    rdfs:subClassOf cde:Etiology ;
    skos:closeMatch radlex:RID5045 ;
    skos:definition "Caused by wear or ageing." ;
    skos:exactMatch sct:308490002 ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-Degenerative-RADLEX-RID5045,
        cde:binding-Degenerative-SNOMEDCT-308490002 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "ET-000008" ;
    cde:nodeType "Etiology" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

