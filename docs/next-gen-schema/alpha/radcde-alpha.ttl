    skos:exactMatch sct:237495005,
        radlex:RID50509 ;
    skos:prefLabel "thyroid nodule" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "Margin values follow ACR TI-RADS 2017: smooth, ill-defined, lobulated or irregular, extra-thyroidal extension. Lobulated and irregular are one scoring category in the scheme and are kept separate here, because a radiologist can say which and the scheme discarding that is the scheme's choice, not ours. Spiculated is subsumed under irregular, which TI-RADS defines as jagged, spiculated or sharp angles." ;
    cde:hasBinding cde:binding-ThyroidNodule-RADLEX-RID50509,
        cde:binding-ThyroidNodule-SNOMEDCT-237495005 ;
