cde:V_000420_Rounded a owl:Class ;
    rdfs:label "rounded" ;
    rdfs:subClassOf cde:AtelectasisMorphologyValue ;
    owl:disjointWith cde:V_000421_Linear,
        cde:V_000422_Lobar,
        cde:V_000423_Segmental,
        cde:V_000424_Subsegmental ;
    skos:definition "A rounded subpleural opacity with vessels swirling into it, associated with pleural disease. A mass mimic." ;
    skos:exactMatch radlex:RID28494 ;
    skos:prefLabel "rounded" ;
    cde:conceptSource "Fleischner Society" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-V_000420_Rounded-RADLEX-RID28494 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "V-000420" ;
    cde:nodeType "Value" ;
    cde:sourceDefinition """Pathology.—Rounded atelectasis is rounded collapsed lung associated with invaginated fibrotic pleura and thickened and fibrotic interlobular septa. Most frequently, it is the consequence of an asbestos-induced exudative pleural effusion with resultant pleural scarring (121), but it may occur with any cause of pleural fibrosis. 
Radiographs and CT scans.—On chest radiographs, rounded atelectasis appears as a mass abutting a pleural surface, usually in the posterior part of a lower lobe. Distorted vessels have a curvilinear disposition as they converge on the mass (the comet tail sign). The degree of lobar retraction depends on the volume of atelectatic lung. It is almost invariably associated with other signs of pleural fibrosis (eg, blunting of costophrenic angle). CT is more sensitive for the detection and display of the characteristic features of rounded atelectasis (122,123) (Fig 65). An additional sign is homogeneous uptake of contrast medium in the atelectatic lung. Synonyms include folded lung syndrome, helical atelectasis, Blesovsky syndrome, pleural pseudotumor, and pleuroma. [Fleischner Society]""" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

