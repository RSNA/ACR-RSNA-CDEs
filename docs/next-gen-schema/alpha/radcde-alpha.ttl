cde:ExternalCarotidArteryStenosis a owl:Class ;
    rdfs:label "external carotid artery stenosis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:EndDiastolicVelocity ],
        _:N0d3fbc5f490e44caa131b4f25fae1aef,
        [ a owl:Restriction ;
            owl:onProperty cde:hasFlowCharacter ;
            owl:someValuesFrom cde:FlowCharacterValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_NR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasEcaStenosisSignificance ;
            owl:someValuesFrom cde:EcaStenosisSignificanceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:PeakSystolicVelocity ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        cde:FindingClass ;
    skos:definition "Narrowing of the external carotid artery lumen." ;
    skos:prefLabel "external carotid artery stenosis" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "Shares a name with internal carotid artery stenosis and almost nothing else. The internal carotid is graded on five NASCET diameter-ratio bands with two competing percentage methods; the external carotid is graded on two bands read from velocity, because the vessel is small and tortuous and a diameter ratio is unreliable there. Different element, different measurements, different modality emphasis. This demonstrates why similarly named findings must not automatically share DataElements: inserting the internal-carotid stenosis machinery here would incorrectly put NASCET percentages on this class." ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000053" ;
    cde:nodeType "FindingClass" ;
    cde:radlexCompositionBase radlex:RID5016 ;
    cde:radlexCompositionModifier radlex:RID684 ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

