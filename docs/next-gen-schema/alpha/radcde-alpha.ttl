cde:VentricularShuntCatheter a owl:Class ;
    rdfs:label "ventricular shunt catheter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasTipPositionStatus ;
            owl:someValuesFrom cde:TipPositionStatusValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_NR ],
        _:N97dd97721ba24e709699a6e62d58a0b5,
        [ a owl:Restriction ;
            owl:onProperty cde:hasDeviceIntegrity ;
            owl:someValuesFrom cde:DeviceIntegrityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        cde:FindingClass ;
    skos:definition "A catheter placed to divert cerebrospinal fluid from the ventricular system." ;
    skos:prefLabel "ventricular shunt catheter" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:criterion "Intended tip position is the frontal horn of a lateral ventricle. The criterion sits here because it varies per device; the element carries only the verdict." ;
    cde:designNote "Whether a malpositioned tip gates a complication component is the open question." ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000040" ;
    cde:nodeType "FindingClass" ;
    cde:radlexCompositionBase radlex:RID5576 ;
    cde:radlexCompositionModifier radlex:RID7123 ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

