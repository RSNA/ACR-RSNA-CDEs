    cde:localId "DE-000004" ;
    cde:nodeType "DataElement" ;
    cde:selectCardinality "multi" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:AssessmentScheme a owl:Class ;
    rdfs:comment "A named assessment scheme with an issuing authority and its own version clock." ;
    rdfs:subClassOf cde:DefinitionEntity .

cde:Etiology a owl:Class ;
    rdfs:comment "A kind of cause. Target for hasEtiology." ;
    rdfs:subClassOf cde:DefinitionEntity .

cde:SP_AB a owl:Class ;
    rdfs:label "Abdominal Radiology" ;
    rdfs:subClassOf cde:Subspecialty ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "AB" ;
    cde:nodeType "Subspecialty" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:SeverityValue a owl:Class ;
    rdfs:label "severity value" ;
    rdfs:comment "Permitted answers for the 'severity' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
    rdfs:subClassOf cde:Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( cde:V_000190_Minimal cde:V_000191_Mild cde:V_000192_Moderate cde:V_000193_Severe ) ] .

cde:mayCause a owl:ObjectProperty ;
    rdfs:comment "Causal. The source can produce the target as a distinct second entity. Distinct from mayManifestAs, which is about evidence rather than production." ;
    cde:inferenceBearing false .

cde:DistributionValue a owl:Class ;
    rdfs:label "distribution value" ;
    rdfs:comment "Permitted answers for the 'distribution' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
    rdfs:subClassOf cde:Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( cde:V_000120_Solitary cde:V_000121_Scattered cde:V_000122_Clustered cde:V_000123_Random cde:V_000124_Centrilobular cde:V_000125_Perilymphatic cde:V_000126_Miliary ) ] .

cde:LongAxisDiameter a owl:Class ;
    rdfs:label "long-axis diameter" ;
    rdfs:subClassOf cde:Measurement ;
    skos:definition "The greatest diameter of the lesion on the plane showing its maximal dimension." ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "MS-000001" ;
    cde:measurementMethod "Greatest diameter on a single plane, measured on the sequence or window in which the lesion is best seen." ;
    cde:nodeType "Measurement" ;
    cde:permittedUnit "cm",
        "mm" ;
    cde:quantityKind "length" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:PleuralEffusion a owl:Class ;
    rdfs:label "pleural effusion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:Atelectasis ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:MediastinalLymphadenopathy ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:GroundGlassOpacity ],
        _:N67110d24809e40859f3b3ceee9a102e8,
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAmount ;
            owl:someValuesFrom cde:AmountValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasInternalComplexity ;
            owl:someValuesFrom cde:InternalComplexityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:AttenuationHU ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:Consolidation ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:Volume ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        cde:FindingClass ;
    skos:altLabel "effusion",
        "pleural fluid" ;
    skos:definition "Fluid within the pleural space beyond the physiologic few millilitres." ;
    skos:exactMatch radlex:RID34539,
        sct:60046008 ;
    skos:prefLabel "pleural effusion" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "The first non-focal finding in the build. No margin, no size measurement, no distribution. Amount, attenuation and internal complexity instead. Its co-occurrences are the honest statement where no causal or evidential claim is warranted: an effusion is often seen with these, and saying which produced which would be guessing. Stored once, symmetric." ;
    cde:hasBinding cde:binding-PleuralEffusion-RADLEX-RID34539,
        cde:binding-PleuralEffusion-SNOMEDCT-60046008 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "pleural fluid" ;
            cde:synonymType "synonym" ],
        [ cde:synonymScope "exact" ;
            cde:synonymTerm "effusion" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000021" ;
    cde:nodeType "FindingClass" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:SP_CH a owl:Class ;
    rdfs:label "Chest Radiology" ;
    rdfs:subClassOf cde:Subspecialty ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "CH" ;
    cde:nodeType "Subspecialty" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:CalcificationValue a owl:Class ;
    rdfs:label "calcification value" ;
    rdfs:comment "Permitted answers for the 'calcification' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
    rdfs:subClassOf cde:Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( cde:V_000030_None cde:V_000031_Central cde:V_000032_Popcorn cde:V_000033_Punctate cde:V_000034_Coarse cde:V_000035_PeripheralRim ) ] .

cde:Measurement a owl:Class ;
    rdfs:comment "A quantitative attribute, carrying method and conventions." ;
    rdfs:subClassOf cde:DefinitionEntity ;
    owl:disjointWith cde:AnatomicLocation,
        cde:AssessmentScheme .

cde:Subspecialty a owl:Class ;
    rdfs:comment "A radiology subspecialty." ;
    rdfs:subClassOf cde:DefinitionEntity .

cde:hasLaterality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "laterality" ;
    rdfs:range cde:LateralityValue ;
    rdfs:subPropertyOf cde:hasDataElement ;
    skos:definition "Which side of a paired structure the finding involves." ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "DE-000031" ;
    cde:nodeType "DataElement" ;
    cde:selectCardinality "single" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:hasEtiology a owl:ObjectProperty ;
    rdfs:comment "Relates a definition to the kind of cause behind it." .

cde:Diagnosis a owl:Class ;
    rdfs:comment "What a radiologist may conclude." ;
    rdfs:subClassOf cde:DefinitionEntity ;
    owl:disjointWith cde:AnatomicLocation,
        cde:AssessmentScheme,
        cde:Measurement,
        cde:Value .

cde:scopedToSpecific a owl:ObjectProperty ;
    rdfs:comment "Scope checked by identity or subsumption. kind=specific." ;
    rdfs:subPropertyOf cde:scopedTo .

cde:LateralityValue a owl:Class ;
    rdfs:label "laterality value" ;
    rdfs:comment "Permitted answers for the 'laterality' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
    rdfs:subClassOf cde:Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( cde:V_000300_Left cde:V_000301_Right cde:V_000302_Bilateral cde:V_000303_Midline ) ] .

cde:AssessmentCategory a owl:Class ;
    rdfs:comment "One category of an assessment scheme." .

cde:hasCategory a owl:ObjectProperty ;
    rdfs:comment "Relates an AssessmentScheme to one of its categories." .

cde:inSubspecialty a owl:ObjectProperty ;
    rdfs:comment "The radiology subspecialty a finding belongs to." .

cde:FindingClass a owl:Class ;
    rdfs:comment "A discrete observable entity." ;
    rdfs:subClassOf cde:DefinitionEntity ;
    owl:disjointWith cde:AnatomicLocation,
        cde:AssessmentScheme,
        cde:Diagnosis,
        cde:Measurement,
        cde:Value .

cde:hasDataElement a owl:ObjectProperty ;
    rdfs:comment "Parent of every element property. Each DataElement is a subproperty." .

cde:Value a owl:Class ;
    rdfs:comment "A single coded permissible answer for a DataElement." ;
    rdfs:subClassOf cde:DefinitionEntity ;
    owl:disjointWith cde:AnatomicLocation,
        cde:AssessmentScheme,
        cde:Measurement .

cde:mayManifestAs a owl:ObjectProperty ;
    rdfs:comment "Evidential. The diagnosis can show itself as the target. Carries typicality (how often) and specificity (how much seeing it narrows the differential). Annotation-only." ;
    cde:epistemic true ;
    cde:inferenceBearing false .

cde:XR a owl:Class ;
    rdfs:label "Projection Radiography" ;
    rdfs:subClassOf cde:Modality ;
    skos:exactMatch radlex:RID10345 ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-XR-RADLEX-RID10345 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "XR" ;
    cde:nodeType "Modality" ;
    cde:sourceDefinition "Examination of any part of the body for diagnostic purposes by means of roentgen rays, recording the image on a sensitized surface (such as photographic film). [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:hasMeasurement a owl:ObjectProperty ;
    rdfs:comment "Relates a FindingClass or Diagnosis to a Measurement." .

cde:scopedToRegion a owl:ObjectProperty ;
    rdfs:comment "Scope checked by containment along partOf. kind=region." ;
    rdfs:subPropertyOf cde:scopedTo ;
    owl:propertyChainAxiom ( cde:scopedToRegion cde:partOf ) ;
    cde:designNote "Property chain scopedToRegion o partOf -> scopedToRegion. A finding scoped to a lobe is thereby scoped to the lung, without every combination being written out. This is the mechanism behind decision-register item 3, anatomic scope stored or inferred." .

cde:MR a owl:Class ;
    rdfs:label "Magnetic Resonance Imaging" ;
    rdfs:subClassOf cde:Modality ;
    skos:exactMatch radlex:RID10312 ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-MR-RADLEX-RID10312 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "MR" ;
    cde:nodeType "Modality" ;
    cde:sourceDefinition "Non-invasive method of demonstrating internal anatomy based on the principle that atomic nuclei in a strong magnetic field absorb pulses of radiofrequency energy and emit them as radiowaves which can be reconstructed into computerized images. The concept includes proton spin tomographic techniques. [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:hasIntervalChange a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "interval change" ;
    rdfs:range cde:IntervalChangeValue ;
    rdfs:subPropertyOf cde:hasDataElement ;
    skos:definition "The relationship of the finding to the same finding on a prior comparable examination." ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "DE-000015" ;
    cde:nodeType "DataElement" ;
    cde:selectCardinality "single" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:CT a owl:Class ;
    rdfs:label "Computed Tomography" ;
    rdfs:subClassOf cde:Modality ;
    skos:exactMatch radlex:RID10321 ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-CT-RADLEX-RID10321 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "CT" ;
    cde:nodeType "Modality" ;
    cde:sourceDefinition "Tomography using x-ray transmission and a computer algorithm to reconstruct the image. [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:US a owl:Class ;
    rdfs:label "Ultrasound" ;
    rdfs:subClassOf cde:Modality ;
    skos:exactMatch radlex:RID10326 ;
    cde:conceptSource "Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-US-RADLEX-RID10326 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "US" ;
    cde:nodeType "Modality" ;
    cde:sourceDefinition "The visualization of deep structures of the body by recording the reflections of echoes of pulses of ultrasonic waves directed into the tissues. Use of ultrasound for imaging or diagnostic purposes employs frequencies ranging from 1.6 to 10 megahertz. [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

cde:IntervalChangeValue a owl:Class ;
    rdfs:label "interval change value" ;
    rdfs:comment "Permitted answers for the 'interval change' element. The HAS_VALUE edges of the definition graph appear here as subclasses." ;
    rdfs:subClassOf cde:Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( cde:V_000140_New cde:V_000141_Unchanged cde:V_000142_Increased cde:V_000143_Decreased cde:V_000144_NoPriorAvailable ) ] .

cde:hasPresence a owl:FunctionalProperty,
