cde:hasAcuity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "acuity" ;
    rdfs:range cde:AcuityValue ;
    rdfs:subPropertyOf cde:hasDataElement ;
    skos:definition "How old the finding is, judged from its appearance rather than from a comparison. A healed fracture on a first study has no prior to compare against and is still recognisably old." ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "DE-000034" ;
    cde:nodeType "DataElement" ;
    cde:selectCardinality "single" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

