cde:GroundGlassOpacity a owl:Class ;
    rdfs:label "ground-glass opacity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        _:N5af57f7b2b39480081bc4262a3eae1ca,
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasExtent ;
            owl:someValuesFrom cde:ExtentValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasDistribution ;
            owl:someValuesFrom cde:DistributionValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        cde:FindingClass ;
    skos:definition "Hazy increased lung attenuation that does not obscure the vessels." ;
    skos:exactMatch radlex:RID28531,
        sct:1217294009 ;
    skos:prefLabel "ground-glass opacity" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Fleischner Society, LID" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-GroundGlassOpacity-RADLEX-RID28531,
        cde:binding-GroundGlassOpacity-SNOMEDCT-1217294009 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000025" ;
    cde:nodeType "FindingClass" ;
    cde:sourceDefinition "Radiographs and CT scans.—On chest radiographs, ground-glass opacity appears as an area of hazy increased lung opacity, usually extensive, within which margins of pulmonary vessels may be indistinct. On CT scans, it appears as hazy increased opacity of lung, with preservation of bronchial and vascular margins (Fig 23). It is caused by partial filling of airspaces, interstitial thickening (due to fluid, cells, and/or fibrosis), partial collapse of alveoli, increased capillary blood volume, or a combination of these, the common factor being the partial displacement of air (59,60). Ground-glass opacity is less opaque than consolidation, in which bronchovascular margins are obscured. (See also consolidation.) [Fleischner Society]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

