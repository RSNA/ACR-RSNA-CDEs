    rdfs:label "rib fracture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasFractureDisplacement ;
            owl:someValuesFrom cde:FractureDisplacementValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        _:N26f7d5b8bc0b4c2094517389d2100ab8,
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasComminution ;
            owl:someValuesFrom cde:ComminutionValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:DisplacementDistance ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAcuity ;
            owl:someValuesFrom cde:AcuityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
