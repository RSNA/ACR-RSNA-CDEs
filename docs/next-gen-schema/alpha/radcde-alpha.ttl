cde:PleuralEffusion a owl:Class ;
    rdfs:label "pleural effusion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasInternalComplexity ;
            owl:someValuesFrom cde:InternalComplexityValue ],
        _:N0ceb05500c3349e6935ea0689332c674,
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:Atelectasis ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAmount ;
            owl:someValuesFrom cde:AmountValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:Volume ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:AttenuationHU ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:GroundGlassOpacity ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:MediastinalLymphadenopathy ],
        [ a owl:Restriction ;
            owl:onProperty cde:occursWith ;
            owl:someValuesFrom cde:Consolidation ],
        cde:FindingClass ;
    skos:altLabel "effusion",
        "pleural fluid" ;
    skos:definition "Fluid within the pleural space beyond the physiologic few millilitres." ;
    skos:exactMatch sct:60046008,
        radlex:RID34539 ;
    skos:prefLabel "pleural effusion" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "The first non-focal finding in the build. No margin, no size measurement, no distribution. Amount, attenuation and internal complexity instead. Its co-occurrences are the honest statement where no causal or evidential claim is warranted: an effusion is often seen with these, and saying which produced which would be guessing. Stored once, symmetric." ;
    cde:hasBinding cde:binding-PleuralEffusion-RADLEX-RID34539,
        cde:binding-PleuralEffusion-SNOMEDCT-60046008 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "effusion" ;
            cde:synonymType "synonym" ],
        [ cde:synonymScope "exact" ;
            cde:synonymTerm "pleural fluid" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000021" ;
    cde:nodeType "FindingClass" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

