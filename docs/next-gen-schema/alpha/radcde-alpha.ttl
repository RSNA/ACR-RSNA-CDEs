        cde:FindingClass ;
    skos:altLabel "airspace opacity" ;
    skos:definition "Replacement of alveolar air by fluid, cells or other material, obscuring the underlying vessels." ;
    skos:exactMatch radlex:RID43255,
        sct:95436008 ;
    skos:prefLabel "consolidation" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Fleischner Society" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Scoped to lung parenchyma, which reaches lung only through a locally authored gap-fill edge. Without it this class derives no body region." ;
    cde:hasBinding cde:binding-Consolidation-RADLEX-RID43255,
        cde:binding-Consolidation-SNOMEDCT-95436008 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "airspace opacity" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000024" ;
    cde:nodeType "FindingClass" ;
    cde:sourceDefinition "Consolidation refers to an exudate or other product of disease that replaces alveolar air, rendering the lung solid (as in infective pneumonia). Radiographs and CT scans.—[Fleischner Society]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

