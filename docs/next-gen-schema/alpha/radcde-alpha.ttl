cde:InternalCarotidArteryStenosis a owl:Class ;
    rdfs:label "internal carotid artery stenosis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        _:N22effaf9d5d245549f7a74c7d2154653,
        [ a owl:Restriction ;
            owl:onProperty cde:hasNarrowingDegree ;
            owl:someValuesFrom cde:NarrowingDegreeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:InvolvedLength ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_NR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:ECSTPercentStenosis ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:NASCETPercentStenosis ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:ResidualLumenDiameter ],
        cde:FindingClass ;
    skos:definition "Narrowing of the internal carotid artery lumen." ;
    skos:prefLabel "internal carotid artery stenosis" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "Named for the vessel it is scoped to. Carotid stenosis names a family: the common and external carotid arteries stenose too, and their measurements take different baseline landmarks, so they are separate classes rather than values on one. Carries both the ordinal band and the percentage, and both NASCET and ECST. They are not alternatives and nothing converts between them: 70 percent NASCET is roughly 85 percent ECST, so a consumer reading one as the other would be wrong by a management threshold." ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000034" ;
    cde:nodeType "FindingClass" ;
    cde:radlexCompositionBase radlex:RID5016 ;
    cde:radlexCompositionModifier radlex:RID585 ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

