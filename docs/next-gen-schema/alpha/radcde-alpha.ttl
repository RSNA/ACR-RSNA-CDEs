cde:Metabolic a owl:Class ;
    rdfs:label "metabolic" ;
    rdfs:subClassOf cde:Etiology ;
    skos:definition "Caused by a metabolic derangement." ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "ET-000009" ;
    cde:nodeType "Etiology" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:MuralNodule a owl:Class ;
    rdfs:label "mural nodule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:componentOf ;
            owl:someValuesFrom cde:ComplexRenalCyst ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasEnhancementPattern ;
            owl:someValuesFrom cde:EnhancementPatternValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:LongAxisDiameter ],
        cde:FindingClass ;
    skos:definition "A solid nodular projection from the wall of a fluid-filled structure." ;
    skos:prefLabel "mural nodule" ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "It is a nodule, and the mural part is already carried by COMPONENT_OF: a nodule that is a component of a cyst is a mural nodule. Asking for the pre-coordinated term would duplicate what the graph already says." ;
    cde:isComponent true ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "FC-000014" ;
    cde:nodeType "FindingClass" ;
    cde:radlexCompositionBase radlex:RID3875 ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

