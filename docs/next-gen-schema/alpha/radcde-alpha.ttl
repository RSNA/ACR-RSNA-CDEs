cde:NASCETPercentStenosis a owl:Class ;
    rdfs:label "NASCET percent stenosis" ;
    rdfs:subClassOf cde:Measurement ;
    skos:definition "Percentage reduction of the internal carotid lumen, by the NASCET method." ;
    cde:created "2026-09-14"^^xsd:date ;
    cde:designNote "Separate from the ECST method rather than a value on one measurement, because they are different numbers from the same image: roughly 70 percent NASCET is 85 percent ECST. A model that lets a consumer read one as the other is worse than one carrying neither." ;
    cde:lastModified "2026-09-14"^^xsd:date ;
    cde:localId "MS-000014" ;
    cde:measurementMethod "Residual lumen at the stenosis divided by the diameter of the normal distal internal carotid artery, beyond the bulb. The denominator is the landmark that makes this method carotid-specific." ;
    cde:nodeType "Measurement" ;
    cde:permittedUnit "%" ;
    cde:quantityKind "fraction" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

