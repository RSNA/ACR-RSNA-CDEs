  <rdf:Description rdf:about="https://radelement.org/ng/V_000393_Irregular">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>irregular</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/ThyroidMarginValue"/>
    <owl:disjointWith rdf:resource="https://radelement.org/ng/V_000394_ExtraThyroidalExtension"/>
    <skos:definition>Jagged, spiculated or with sharp angles.</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID5715"/>
    <skos:prefLabel>irregular</skos:prefLabel>
    <cde:conceptSource>BI-RADS 5; PI-RADS 2, TI-RADS</cde:conceptSource>
