    <cde:nodeType>AnatomicLocation</cde:nodeType>
    <cde:source>imported</cde:source>
    <cde:sourceDefinition>A pair of glands located at the cranial pole of each of the two kidneys. Each adrenal gland is composed of two distinct endocrine tissues with separate embryonic origins, the adrenal cortex producing steroids and the adrenal medulla producing neurotransmitters. [MeSH]</cde:sourceDefinition>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>published</cde:versionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID665">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>middle cerebral artery</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n3f69c244fea946bbbb1df0e721d6cebbb44"/>
    <rdfs:subClassOf rdf:nodeID="n3f69c244fea946bbbb1df0e721d6cebbb45"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID35904"/>
    <skos:altLabel xml:lang="la">arteria cerebri media</skos:altLabel>
    <skos:definition>The largest and most complex of the cerebral arteries. Branches of the middle cerebral artery supply the insular region, motor and premotor areas, and large regions of the association cortex. [MeSH]</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID665"/>
    <skos:prefLabel>middle cerebral artery</skos:prefLabel>
