  <rdf:Description rdf:about="https://radelement.org/ng/V_000382_Irregular">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>irregular</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/PulmonaryMarginValue"/>
    <owl:disjointWith rdf:resource="https://radelement.org/ng/V_000383_Spiculated"/>
