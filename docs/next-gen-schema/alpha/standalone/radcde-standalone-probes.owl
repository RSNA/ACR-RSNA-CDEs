    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/Diagnosis"/>
    <skos:definition>Pyelonephritis with established parenchymal damage from prior or recurrent infection.</skos:definition>
    <skos:exactMatch rdf:resource="http://snomed.info/id/63302006"/>
    <skos:prefLabel>chronic pyelonephritis</skos:prefLabel>
