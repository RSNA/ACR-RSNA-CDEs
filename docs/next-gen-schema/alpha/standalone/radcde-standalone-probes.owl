  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID648">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>anterior cerebral artery</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n3f69c244fea946bbbb1df0e721d6cebbb42"/>
