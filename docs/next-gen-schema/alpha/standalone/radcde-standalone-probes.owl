  <rdf:Description rdf:about="https://radelement.org/ng/HepatocellularCarcinoma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>hepatocellular carcinoma</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b72"/>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b73"/>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b74"/>
