    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/FindingClass"/>
    <skos:altLabel>airspace opacity</skos:altLabel>
    <skos:definition>Replacement of alveolar air by fluid, cells or other material, obscuring the underlying vessels.</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID43255"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/95436008"/>
    <skos:prefLabel>consolidation</skos:prefLabel>
    <cde:anchorVerdict>anchored</cde:anchorVerdict>
    <cde:conceptSource>Fleischner Society</cde:conceptSource>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:designNote>Scoped to lung parenchyma, which reaches lung only through a locally authored gap-fill edge. Without it this class derives no body region.</cde:designNote>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-Consolidation-RADLEX-RID43255"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-Consolidation-SNOMEDCT-95436008"/>
    <cde:hasSynonym rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b545"/>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
    <cde:localId>FC-000024</cde:localId>
    <cde:nodeType>FindingClass</cde:nodeType>
    <cde:sourceDefinition>Consolidation refers to an exudate or other product of disease that replaces alveolar air, rendering the lung solid (as in infective pneumonia). Radiographs and CT scans.—[Fleischner Society]</cde:sourceDefinition>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
  </rdf:Description>
