  <rdf:Description rdf:about="https://radelement.org/ng/V_000322_Macrocalcifications">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>macrocalcifications</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/EchogenicFociValue"/>
    <owl:disjointWith rdf:resource="https://radelement.org/ng/V_000323_PeripheralRimCalcifications"/>
    <owl:disjointWith rdf:resource="https://radelement.org/ng/V_000324_PunctateEchogenicFoci"/>
    <skos:definition>Coarse calcification causing acoustic shadowing.</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID34369"/>
    <skos:prefLabel>macrocalcifications</skos:prefLabel>
    <cde:conceptSource>BI-RADS 4, TI-RADS</cde:conceptSource>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-V_000322_Macrocalcifications-RADLEX-RID34369"/>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
    <cde:localId>V-000322</cde:localId>
    <cde:nodeType>Value</cde:nodeType>
    <cde:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cde:rank>
    <cde:sourceDefinition>BI-RADS US:Macrocalcifcations are coarse calcifications that are 0.5mm or greater in size.  As in other areas of the body, macrocalcifications will attenuate the acoustic beam and cause acoustic shadowing.</cde:sourceDefinition>
    <cde:versionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cde:versionNumber>
    <cde:versionStatus>proposed</cde:versionStatus>
  </rdf:Description>
