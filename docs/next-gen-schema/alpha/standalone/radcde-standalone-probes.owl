  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID15863">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>portion of neural tissue</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID13298"/>
    <skos:altLabel>nervous tissue</skos:altLabel>
    <skos:altLabel>neural tissue</skos:altLabel>
    <skos:altLabel xml:lang="la">textus nervosus</skos:altLabel>
