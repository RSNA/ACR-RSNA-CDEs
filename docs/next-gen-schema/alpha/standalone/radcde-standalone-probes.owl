    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/FindingClass"/>
    <skos:definition>A nodule within the thyroid gland.</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID50509"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/237495005"/>
    <skos:prefLabel>thyroid nodule</skos:prefLabel>
    <cde:anchorVerdict>anchored</cde:anchorVerdict>
    <cde:conceptSource>ACR TI-RADS</cde:conceptSource>
    <cde:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:created>
    <cde:designNote>Margin values follow ACR TI-RADS 2017: smooth, ill-defined, lobulated or irregular, extra-thyroidal extension. Lobulated and irregular are one scoring category in the scheme and are kept separate here, because a radiologist can say which and the scheme discarding that is the scheme's choice, not ours. Spiculated is subsumed under irregular, which TI-RADS defines as jagged, spiculated or sharp angles.</cde:designNote>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-ThyroidNodule-RADLEX-RID50509"/>
    <cde:hasBinding rdf:resource="https://radelement.org/ng/binding-ThyroidNodule-SNOMEDCT-237495005"/>
    <cde:lastModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</cde:lastModified>
