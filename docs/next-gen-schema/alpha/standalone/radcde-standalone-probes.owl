    <owl:equivalentClass rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b290"/>
    <skos:definition>A renal cyst whose contents are not uniformly fluid.</skos:definition>
    <skos:prefLabel>complex renal cyst</skos:prefLabel>
    <cde:anchorBase rdf:resource="http://radlex.org/RID/RID3890"/>
    <cde:anchorModifier rdf:resource="http://radlex.org/RID/RID205"/>
