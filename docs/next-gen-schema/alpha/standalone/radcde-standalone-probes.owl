  <rdf:Description rdf:about="https://radelement.org/ng/anatomy/RID1362">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>pleura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n3f69c244fea946bbbb1df0e721d6cebbb98"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/AnatomicLocation"/>
    <rdfs:subClassOf rdf:resource="https://radelement.org/ng/anatomy/RID35857"/>
    <skos:definition>The thin serous membrane enveloping the lungs (lung) and lining the thoracic cavity. Pleura consist of two layers, the inner visceral pleura lying next to the pulmonary parenchyma and the outer parietal pleura. Between the two layers is the pleural cavity which contains a thin film of liquid. [MeSH]</skos:definition>
    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID1362"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/3120008"/>
    <skos:prefLabel>pleura</skos:prefLabel>
    <cde:conceptSource>Playbook</cde:conceptSource>
