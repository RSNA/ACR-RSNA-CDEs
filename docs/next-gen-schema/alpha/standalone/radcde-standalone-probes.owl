  <rdf:Description rdf:about="https://radelement.org/ng/ExternalCarotidArteryStenosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>external carotid artery stenosis</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b55"/>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b56"/>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b57"/>
    <rdfs:subClassOf rdf:nodeID="n18ec46086f304a00955c944e6c60b2e7b58"/>
