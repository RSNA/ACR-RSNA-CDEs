    <skos:exactMatch rdf:resource="http://radlex.org/RID/RID5715"/>
    <skos:prefLabel>irregular</skos:prefLabel>
    <cde:conceptSource>BI-RADS 5; PI-RADS 2, TI-RADS</cde:conceptSource>
