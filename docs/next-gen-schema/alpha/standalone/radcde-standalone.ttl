cde:Atelectasis a owl:Class ;
    rdfs:label "atelectasis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAtelectasisMorphology ;
            owl:someValuesFrom cde:AtelectasisMorphologyValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasExtent ;
            owl:someValuesFrom cde:ExtentValue ],
        _:nd08b783fd3114bc3a4f51be6efe74752b522,
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAtelectasisMechanism ;
            owl:someValuesFrom cde:AtelectasisMechanismValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        cde:FindingClass ;
    skos:altLabel "collapse" ;
    skos:definition "Incomplete expansion or collapse of lung tissue." ;
    skos:exactMatch radlex:RID28493,
        sct:46621007 ;
    skos:prefLabel "atelectasis" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Fleischner Society" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "One class with two independent axes rather than five subtypes. Mechanism and morphology co-occur, so neither partitions the other, and the five classes this replaces were distinguished by nothing in the model: identical scope, identical elements, no defining value." ;
    cde:hasBinding cde:binding-Atelectasis-RADLEX-RID28493,
        cde:binding-Atelectasis-SNOMEDCT-46621007 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "collapse" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000006B" ;
    cde:nodeType "FindingClass" ;
    cde:sourceDefinition """Pathophysiology.—Atelectasis is reduced inflation of all or part of the lung (20). One of the commonest mechanisms is resorption of air distal to airway obstruction (eg, an endobronchial neoplasm) (21). The synonym collapse is often used interchangeably with atelectasis, particularly when it is severe or accompanied by obvious increase in lung opacity. 
Radiographs and CT scans.—Reduced volume is seen, accompanied by increased opacity (chest radiograph) or attenuation (CT scan) in the affected part of the lung (Fig 8). Atelectasis is often associated with abnormal displacement of fissures, bronchi, vessels, diaphragm, heart, or mediastinum (22). The distribution can be lobar, segmental, or subsegmental. Atelectasis is often qualified by descriptors such as linear, discoid, or platelike. (See also linear atelectasis, rounded atelectasis.)  [Fleischner Society]""" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

