cde:SimpleRenalCyst a owl:Class ;
    rdfs:label "simple renal cyst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        cde:RenalCyst ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cde:RenalCyst [ a owl:Restriction ;
                        owl:onProperty cde:hasComposition ;
                        owl:someValuesFrom cde:V_000050_Cystic ] ) ] ;
    skos:broadMatch radlex:RID49690 ;
    skos:definition "A renal cyst with uniformly fluid contents." ;
    skos:exactMatch sct:77945009 ;
    skos:prefLabel "simple renal cyst" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "BI-RADS 5," ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Defined class: conditions are necessary and sufficient, so a reasoner classifies into it. Nothing about it is authored twice." ;
    cde:hasBinding cde:binding-SimpleRenalCyst-RADLEX-RID49690,
        cde:binding-SimpleRenalCyst-SNOMEDCT-77945009 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000016" ;
    cde:nodeType "FindingClass" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:UnresolvedMention a owl:Class ;
    rdfs:comment "Text naming something finding-shaped that did not become a coded finding. Not a FindingClass and disjoint from one. With no abstract genus there is no vague class to absorb these, so they are recorded as extraction artifacts: countable, so that underspecification can be measured, and carrying the reason, so a report that said nothing is distinguishable from a pipeline that missed something. See D-21." ;
    owl:disjointWith cde:FindingClass .

cde:abuts a owl:ObjectProperty ;
    rdfs:comment "Contacts a structure without disrupting it." ;
    rdfs:subPropertyOf cde:actsOn .

