cde:AcuteInfarct a owl:Class ;
    rdfs:label "acute infarct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasVascularTerritory ;
            owl:someValuesFrom cde:VascularTerritoryValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        _:nd08b783fd3114bc3a4f51be6efe74752b260,
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_NR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        cde:FindingClass ;
    skos:definition "Recent ischaemic tissue death, with restricted diffusion and loss of grey-white differentiation." ;
    skos:prefLabel "acute infarct" ;
    cde:anchorBase radlex:RID5172 ;
    cde:anchorModifier radlex:RID5718 ;
    cde:anchorVerdict "post_coordinated" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Scoped to brain, with the arterial territory carried as an element rather than as scope. RadLex has the cerebral arteries but no concept for the parenchyma each supplies, so territory cannot currently be an anatomic scope claim." ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000029" ;
    cde:nodeType "FindingClass" ;
    cde:source "local" ;
    cde:sourceStatus "unrequested" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:BIRADS_BI_RADS_1 a owl:Class ;
    rdfs:label "BI-RADS 1" ;
    rdfs:subClassOf cde:AssessmentCategory ;
    owl:disjointWith cde:BIRADS_BI_RADS_2,
        cde:BIRADS_BI_RADS_3,
        cde:BIRADS_BI_RADS_4,
        cde:BIRADS_BI_RADS_5,
        cde:BIRADS_BI_RADS_6 ;
    cde:rank 1 .

