    skos:definition "Infection of the lung parenchyma." ;
    skos:exactMatch radlex:RID5350,
        sct:233604007 ;
    skos:prefLabel "pneumonia" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Fleischner Society" ;
    cde:created "2026-09-10"^^xsd:date ;
