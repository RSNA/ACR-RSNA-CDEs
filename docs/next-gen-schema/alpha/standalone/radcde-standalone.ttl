cde:RenalLength a owl:Class ;
    rdfs:label "renal length" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:scopedToClass ;
            owl:someValuesFrom anat:RID205 ],
        cde:Measurement ;
    skos:definition "The greatest pole-to-pole dimension of the kidney." ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Carries anatomic scope directly and belongs to no FindingClass. This is the alternative to letting HAS_MEASUREMENT originate from an AnatomicLocation. ",
        "Named for the kidney, not for organs generally, because the method is a kidney method: pole-to-pole is not how a liver or a spleen is measured. A measurement IS its method, so a generic organ length with no method would carry no content, and a generic one with several methods would not say which applied. Another organ needing a length gets its own measurement with its own method. Nothing is lost by not having a shared parent: quantity_kind already groups every length. A normal-structure descriptor; renal enlargement is an interpretation of this value, not a measurement of its own." ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "MS-000012" ;
    cde:measurementMethod "Greatest pole-to-pole length on the plane of maximal dimension." ;
    cde:nodeType "Measurement" ;
    cde:permittedUnit "cm",
        "mm" ;
    cde:quantityKind "length" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

