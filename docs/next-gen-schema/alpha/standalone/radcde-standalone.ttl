anat:RID28538 a owl:Class ;
    rdfs:label "airspace" ;
    rdfs:subClassOf cde:AnatomicLocation,
        anat:RID1296 ;
    skos:definition """Anatomy.—An airspace is the gas-containing part of the lung, including the respiratory bronchioles but excluding purely conducting airways, such as terminal bronchioles. 
Radiographs and CT scans.—This term is used in conjunction with consolidation, opacity, and nodules to designate the filling of airspaces with the products of disease (14).  [Fleischner Society]""" ;
    skos:exactMatch radlex:RID28538 ;
    skos:prefLabel "airspace" ;
    cde:conceptSource "Fleischner Society" ;
