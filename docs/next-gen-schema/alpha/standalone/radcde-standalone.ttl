cde:V_000381_Lobulated a owl:Class ;
    rdfs:label "lobulated" ;
    rdfs:subClassOf cde:PulmonaryMarginValue ;
    owl:disjointWith cde:V_000382_Irregular,
        cde:V_000383_Spiculated ;
    skos:definition "The interface undulates with rounded protrusions." ;
    skos:exactMatch radlex:RID5711 ;
