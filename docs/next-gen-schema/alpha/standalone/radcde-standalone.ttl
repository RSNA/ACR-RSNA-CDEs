cde:MediastinalLymphadenopathy a owl:Class ;
    rdfs:label "mediastinal lymphadenopathy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:ShortAxisDiameter ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasNodalShape ;
            owl:someValuesFrom cde:NodalShapeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasFdgAvidity ;
            owl:someValuesFrom cde:FdgAvidityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        _:nd08b783fd3114bc3a4f51be6efe74752b606,
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:PET ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasNodalArchitecture ;
            owl:someValuesFrom cde:NodalArchitectureValue ],
        cde:FindingClass ;
    skos:altLabel "adenopathy" ;
    skos:broadMatch radlex:RID3798 ;
    skos:definition "Enlargement of one or more mediastinal lymph nodes." ;
    skos:exactMatch sct:52324001 ;
    skos:prefLabel "mediastinal lymphadenopathy" ;
    cde:anchorBase radlex:RID3798 ;
    cde:anchorModifier radlex:RID1384 ;
    cde:anchorVerdict "post_coordinated" ;
    cde:conceptSource "Fleischner Society, BI-RADS 4" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Nodal enlargement is a volume alteration whose direction is gain. RadLex asserts Anatomical_Site RID3798 -> RID13296, so the scope is imported." ;
    cde:hasBinding cde:binding-MediastinalLymphadenopathy-RADLEX-RID3798,
        cde:binding-MediastinalLymphadenopathy-SNOMEDCT-52324001 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "adenopathy" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000012" ;
    cde:nodeType "FindingClass" ;
    cde:sourceDefinition """Diseases of lymph or lymph vessels. [MeSH]
Pathology.—By common usage, the term lymphadenopathy is usually restricted to enlargement, due to any cause, of the lymph nodes. Synonyms include lymph node enlargement (preferred) and adenopathy.
CT scans.—There is a wide range in the size of normal lymph nodes. Mediastinal and hilar lymph nodes range in size from sub-CT resolution to 12 mm. Somewhat arbitrary thresholds for the upper limit of normal of 1 cm in short-axis diameter for mediastinal nodes (79) and 3 mm for most hilar nodes (80) have been reported, but size criteria do not allow reliable differentiation between healthy and diseased lymph nodes (Fig 36).  [Fleischner Society]
BI-RADS MRI:  Enlarged, rounded lymph nodes with loss of fatty hila.""" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

