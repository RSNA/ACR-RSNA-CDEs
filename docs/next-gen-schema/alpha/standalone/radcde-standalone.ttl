        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:LongAxisDiameter ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_AB ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCalcification ;
            owl:someValuesFrom cde:CalcificationValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:MeanDiameter ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:LesionCount ],
        cde:FindingClass ;
    skos:definition "A nodule within the adrenal gland." ;
    skos:prefLabel "adrenal nodule" ;
    cde:anchorBase radlex:RID3875 ;
    cde:anchorModifier radlex:RID88 ;
    cde:anchorVerdict "post_coordinated" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000011" ;
    cde:nodeType "FindingClass" ;
    cde:refinementKind "RID88 may be narrowed to any zone of adrenal gland. NOT ENFORCED HERE: see the permitted_refinements list in the compiled shape for the closed set." ;
    cde:source "local" ;
    cde:sourceStatus "unrequested" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

