anat:RID92 a owl:Class ;
    rdfs:label "cortex of adrenal gland" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:regionalPartOf ;
            owl:someValuesFrom anat:RID88 ],
        cde:AnatomicLocation,
        anat:RID5988 ;
    skos:altLabel "adrenal cortex",
        "cortex of suprarenal gland",
        "cortex glandulae suprarenalis"@la ;
    skos:definition "The outer layer of the adrenal gland. It is derived from mesoderm and comprised of three zones (outer zona glomerulosa, middle zona fasciculata, and inner zona reticularis) with each producing various steroids preferentially, such as aldosterone; hydrocortisone; dehydroepiandrosterone; and androstenedione. Adrenal cortex function is regulated by pituitary adrenocorticotropin. [MeSH]" ;
    skos:exactMatch radlex:RID92 ;
    skos:prefLabel "cortex of adrenal gland" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-RID92-RADLEX-RID92 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "adrenal cortex" ;
            cde:synonymType "synonym" ],
        [ cde:synonymScope "exact" ;
            cde:synonymTerm "cortex of suprarenal gland" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "AL-000010" ;
    cde:nodeType "AnatomicLocation" ;
    cde:source "imported" ;
    cde:sourceDefinition "The outer layer of the adrenal gland. It is derived from mesoderm and comprised of three zones (outer zona glomerulosa, middle zona fasciculata, and inner zona reticularis) with each producing various steroids preferentially, such as aldosterone; hydrocortisone; dehydroepiandrosterone; and androstenedione. Adrenal cortex function is regulated by pituitary adrenocorticotropin. [MeSH]" ;
    cde:versionNumber 1 ;
    cde:versionStatus "published" .

