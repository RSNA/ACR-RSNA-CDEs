cde:hasEchogenicFoci a owl:ObjectProperty ;
    rdfs:label "echogenic foci" ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty cde:scopedToRegion ;
            owl:someValuesFrom anat:RID7578 ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ] ;
    rdfs:range cde:EchogenicFociValue ;
    rdfs:subPropertyOf cde:hasDataElement ;
    skos:definition "Bright foci within a nodule on ultrasound. Not a synonym for calcification: a comet-tail artifact is a reverberation artifact in colloid, not calcium, and is a reassuring feature." ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Multi-select. ACR TI-RADS is explicit that more than one may apply and that their points are additive; it is the only one of its five categories that works this way." ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "DE-000033" ;
    cde:modalityRestriction "ThyroidNodule on echogenic foci: US" ;
    cde:nodeType "DataElement" ;
    cde:selectCardinality "multi" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

