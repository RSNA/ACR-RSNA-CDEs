anat:RID7124 a owl:Class ;
    rdfs:label "lateral ventricle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:constitutionalPartOf ;
            owl:someValuesFrom anat:RID13857 ],
        cde:AnatomicLocation,
        anat:RID7123 ;
    skos:definition "Cavity in each of the cerebral hemispheres derived from the cavity of the embryonic neural tube. They are separated from each other by the septum pellucidum, and each communicates with the third ventricle by the foramen of Monro, through which also the choroid plexuses (choroid plexus) of the lateral ventricles become continuous with that of the third ventricle. [MeSH]" ;
    skos:exactMatch radlex:RID7124 ;
    skos:prefLabel "lateral ventricle" ;
    cde:created "2026-09-10"^^xsd:date ;
