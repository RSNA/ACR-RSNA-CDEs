cde:LungCancer a owl:Class ;
    rdfs:label "lung cancer" ;
    rdfs:subClassOf _:nd08b783fd3114bc3a4f51be6efe74752b725,
        [ a owl:Restriction ;
            owl:onProperty cde:scopedToRegion ;
            owl:someValuesFrom anat:RID1301 ],
        _:nd08b783fd3114bc3a4f51be6efe74752b727,
        _:nd08b783fd3114bc3a4f51be6efe74752b728,
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        _:nd08b783fd3114bc3a4f51be6efe74752b730,
        _:nd08b783fd3114bc3a4f51be6efe74752b731,
        _:nd08b783fd3114bc3a4f51be6efe74752b732,
        _:nd08b783fd3114bc3a4f51be6efe74752b733,
        [ a owl:Restriction ;
            owl:onProperty cde:hasEtiology ;
            owl:someValuesFrom cde:Neoplastic ],
        cde:Diagnosis ;
    skos:altLabel "bronchogenic carcinoma" ;
    skos:definition "Primary malignant neoplasm arising from lung tissue." ;
    skos:exactMatch radlex:RID45686,
        sct:363358000 ;
    skos:prefLabel "lung cancer" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "LID, Playbook" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "Points at each attenuation subtype separately rather than at the parent. Singling out one subtype while the rest relied on the parent edge implied that solid and non-solid nodules were not suggestive of cancer, and left part-solid carrying two specificities at once, one inherited and one direct. NEEDS A RADIOLOGIST: the three specificity values. The claim as written is that part-solid is the most specific for malignancy, solid the commonest presentation but least specific because most solid nodules are benign, and non-solid occasional and indolent. It also reaches a finding by two different edges in different roles: it manifests as a nodule and it causes an effusion." ;
    cde:hasBinding cde:binding-LungCancer-RADLEX-RID45686,
        cde:binding-LungCancer-SNOMEDCT-363358000 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "bronchogenic carcinoma" ;
            cde:synonymType "synonym" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "DX-000004" ;
    cde:nodeType "Diagnosis" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

