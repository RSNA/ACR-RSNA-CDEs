cde:IntracranialHemorrhage a owl:Class ;
    rdfs:label "intracranial hemorrhage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:hasHemorrhageAge ;
            owl:someValuesFrom cde:HemorrhageAgeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAmount ;
            owl:someValuesFrom cde:AmountValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        _:nd08b783fd3114bc3a4f51be6efe74752b656,
        [ a owl:Restriction ;
            owl:onProperty cde:hasCollectionShape ;
            owl:someValuesFrom cde:CollectionShapeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_NR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:AttenuationHU ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:Volume ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        cde:FindingClass ;
    skos:definition "Blood within the cranial cavity. The compartment it occupies is the clinically decisive fact and is carried by the subtypes." ;
    skos:prefLabel "intracranial hemorrhage" ;
    cde:anchorBase radlex:RID4700 ;
    cde:anchorModifier radlex:RID6383 ;
    cde:anchorVerdict "post_coordinated" ;
