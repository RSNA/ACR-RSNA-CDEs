cde:V_000321_LargeCometTailArtifact a owl:Class ;
    rdfs:label "large comet-tail artifact" ;
    rdfs:subClassOf cde:EchogenicFociValue ;
    owl:disjointWith cde:V_000322_Macrocalcifications,
        cde:V_000323_PeripheralRimCalcifications,
        cde:V_000324_PunctateEchogenicFoci ;
    skos:definition "V-shaped reverberation artifact greater than 1 mm in a cystic component. Indicates colloid and is a benign feature." ;
    skos:exactMatch radlex:RID49887 ;
    skos:prefLabel "large comet-tail artifact" ;
    cde:conceptSource "TI-RADS" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:hasBinding cde:binding-V_000321_LargeCometTailArtifact-RADLEX-RID49887 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "V-000321" ;
    cde:nodeType "Value" ;
    cde:rank 2 ;
    cde:sourceDefinition """TI-RADS: Comet-tail artifacts: A comet-tail artifact is a type of
reverberation artifact. The deeper echoes become attenuated and are displayed as decreased width, resulting in a triangular shape. If an echogenic focus does not have this feature, a comet-tail artifact should not be described.""" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

