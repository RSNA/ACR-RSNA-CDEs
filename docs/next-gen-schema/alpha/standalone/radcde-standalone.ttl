cde:PulmonaryNodule a owl:Class ;
    rdfs:label "pulmonary nodule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:MR ],
        [ a owl:Restriction ;
            owl:onProperty cde:inSubspecialty ;
            owl:someValuesFrom cde:SP_CH ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:MeanDiameter ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasIntervalChange ;
            owl:someValuesFrom cde:IntervalChangeValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:XR ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:LongAxisDiameter ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasAttenuation ;
            owl:someValuesFrom cde:AttenuationValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasCalcification ;
            owl:someValuesFrom cde:CalcificationValue ],
        _:nd08b783fd3114bc3a4f51be6efe74752b776,
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:US ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasPulmonaryMargin ;
            owl:someValuesFrom cde:PulmonaryMarginValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasFdgAvidity ;
            owl:someValuesFrom cde:FdgAvidityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasLaterality ;
            owl:someValuesFrom cde:LateralityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:assessedBy ;
            owl:someValuesFrom cde:LungRADS ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasDistribution ;
            owl:someValuesFrom cde:DistributionValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:CT ],
        [ a owl:Restriction ;
            owl:onProperty cde:seenOn ;
            owl:someValuesFrom cde:PET ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasMeasurement ;
            owl:someValuesFrom cde:LesionCount ],
        cde:FindingClass ;
    owl:disjointWith cde:PulmonaryMass ;
    skos:altLabel "SPN",
        "lung nodule" ;
    skos:definition "A nodule within the lung parenchyma." ;
    skos:exactMatch radlex:RID50149 ;
    skos:narrowMatch sct:427359005 ;
    skos:prefLabel "pulmonary nodule" ;
    cde:anchorVerdict "anchored" ;
    cde:conceptSource "Cancer Care Ontario" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:criterion "Distinguished from pulmonary mass at 30 mm greatest dimension (Fleischner Society, chest). Organ- and modality-specific; does not generalise." ;
    cde:hasBinding cde:binding-PulmonaryNodule-RADLEX-RID50149,
        cde:binding-PulmonaryNodule-SNOMEDCT-427359005 ;
    cde:hasSynonym [ cde:synonymScope "exact" ;
            cde:synonymTerm "lung nodule" ;
            cde:synonymType "synonym" ],
        [ cde:synonymScope "narrow" ;
            cde:synonymTerm "SPN" ;
            cde:synonymType "abbreviation" ] ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "FC-000005" ;
    cde:nodeType "FindingClass" ;
    cde:refinementKind "RID1301 may be narrowed to any lobe of lung. NOT ENFORCED HERE: see the permitted_refinements list in the compiled shape for the closed set." ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

