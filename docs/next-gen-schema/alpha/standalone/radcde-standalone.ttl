cde:AcutePyelonephritis a owl:Class ;
    rdfs:label "acute pyelonephritis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cde:scopedToRegion ;
            owl:someValuesFrom anat:RID205 ],
        _:nd08b783fd3114bc3a4f51be6efe74752b437,
        [ a owl:Restriction ;
            owl:onProperty cde:hasPresence ;
            owl:someValuesFrom cde:PresenceValue ],
        _:nd08b783fd3114bc3a4f51be6efe74752b439,
        _:nd08b783fd3114bc3a4f51be6efe74752b440,
        [ a owl:Restriction ;
            owl:onProperty cde:hasSeverity ;
            owl:someValuesFrom cde:SeverityValue ],
        [ a owl:Restriction ;
            owl:onProperty cde:hasEtiology ;
            owl:someValuesFrom cde:Infectious ],
        cde:Diagnosis ;
    skos:definition "Active bacterial infection of the renal parenchyma and collecting system." ;
    skos:exactMatch sct:36689008 ;
    skos:prefLabel "acute pyelonephritis" ;
    cde:anchorBase radlex:RID3547 ;
    cde:anchorModifier radlex:RID5718 ;
    cde:anchorVerdict "post_coordinated" ;
    cde:created "2026-09-10"^^xsd:date ;
    cde:designNote "No unqualified parent. A radiologist always chooses a side, because the acute and chronic pictures look completely different and leaving it ambiguous would be unhelpful to the treating physician. The unqualified term exists for billing, not for reporting. The two are separate classes rather than one class with an acuity element because acuity changes WHICH FINDINGS the diagnosis reaches, not merely what they look like: an acuity value on one class would make chronic pyelonephritis manifest as a striated nephrogram. Compare intracranial haemorrhage, where acuity is an element because acute and chronic blood are the same finding at different densities and nothing else changes. This is also the case that breaks a binary evidential edge: no single manifestation makes the diagnosis, it is the combination, and specificity grades each one alone." ;
    cde:hasBinding cde:binding-AcutePyelonephritis-SNOMEDCT-36689008 ;
    cde:lastModified "2026-09-10"^^xsd:date ;
    cde:localId "DX-000021" ;
    cde:nodeType "Diagnosis" ;
    cde:source "local" ;
    cde:sourceStatus "unrequested" ;
    cde:versionNumber 1 ;
    cde:versionStatus "proposed" .

cde:AdrenalNodule a owl:Class ;
    rdfs:label "adrenal nodule" ;
